--// Mobile Auto Execute Installer
--// Works only if your executor supports writefile + queue_on_teleport

local AUTO_FILE_NAME = "AutoExecute_Main.lua"

local MAIN_SCRIPT = [==[
--==================================================
-- AUTO EXECUTED SCRIPT STARTS HERE
-- Put your real script inside this section
--==================================================

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

repeat task.wait() until LocalPlayer
repeat task.wait() until LocalPlayer:FindFirstChild("PlayerGui")

print("[AUTO EXECUTE] Loaded successfully")

-- Example GUI/status
local gui = Instance.new("ScreenGui")
gui.Name = "AutoExecuteStatus"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer.PlayerGui

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 220, 0, 35)
label.Position = UDim2.new(0, 10, 0, 10)
label.BackgroundTransparency = 0.25
label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
label.TextColor3 = Color3.fromRGB(0, 255, 120)
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.Text = "Auto Execute Loaded"
label.Parent = gui

--==================================================
-- PUT YOUR MAIN SCRIPT BELOW THIS LINE
--==================================================



--==================================================
-- PUT YOUR MAIN SCRIPT ABOVE THIS LINE
--==================================================
]==]

local function notify(msg)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Auto Execute",
        Text = msg,
        Duration = 4
    })
end

local saved = false

if writefile then
    pcall(function()
        writefile(AUTO_FILE_NAME, MAIN_SCRIPT)
        saved = true
    end)
end

if saved then
    print("[AUTO EXECUTE] Saved file:", AUTO_FILE_NAME)
    pcall(function()
        notify("Saved: " .. AUTO_FILE_NAME)
    end)
else
    warn("[AUTO EXECUTE] writefile is not supported by this executor.")
end

--// Re-execute after teleport/server hop if supported
if queue_on_teleport then
    queue_on_teleport([[
        repeat task.wait() until game:IsLoaded()

        if readfile and loadstring and isfile and isfile("]] .. AUTO_FILE_NAME .. [[") then
            loadstring(readfile("]] .. AUTO_FILE_NAME .. [["))()
        end
    ]])

    print("[AUTO EXECUTE] queue_on_teleport enabled")
else
    warn("[AUTO EXECUTE] queue_on_teleport not supported.")
end
