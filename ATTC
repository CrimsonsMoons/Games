--// Settings
local RANGE = 1000
local SIDE_DISTANCE = 3.5 -- how far beside the mob you stand
local Y_OFFSET = 0 -- keep same height as mob
local TELEPORT_DELAY = 0.06
local ATTACKS_PER_MOB = 3
local ATTACK_DELAY = 0.025

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folder
local MobsFolder = workspace:WaitForChild("Mobs", 9e9)

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getMyRoot()
    local character = getCharacter()

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character.PrimaryPart
end

local function getRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    local humanoid = mob:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return false
    end

    local health = mob:GetAttribute("Health")
        or mob:GetAttribute("NewHealth")
        or mob:GetAttribute("HP")

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function getNearestMobs()
    local myRoot = getMyRoot()
    if not myRoot then return {} end

    local mobs = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if mob:IsA("Model") and isMobAlive(mob) then
            local mobRoot = getRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - myRoot.Position).Magnitude

                if distance <= RANGE then
                    mobs[#mobs + 1] = {
                        Model = mob,
                        Root = mobRoot,
                        Distance = distance
                    }
                end
            end
        end
    end

    table.sort(mobs, function(a, b)
        return a.Distance < b.Distance
    end)

    return mobs
end

local function teleportBesideMob(mobRoot)
    local myRoot = getMyRoot()
    if not myRoot or not mobRoot then return end

    local mobCF = mobRoot.CFrame

    -- stand beside the mob, not above it
    local targetPosition =
        mobRoot.Position
        + mobCF.RightVector * SIDE_DISTANCE
        + Vector3.new(0, Y_OFFSET, 0)

    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero

    myRoot.CFrame = CFrame.lookAt(
        targetPosition,
        Vector3.new(mobRoot.Position.X, targetPosition.Y, mobRoot.Position.Z)
    )
end

local function attackMob(mob)
    if not mob or not mob.Parent then return end

    for _ = 1, ATTACKS_PER_MOB do
        if not isMobAlive(mob) then break end

        PlayerAttack:FireServer({
            [1] = mob
        })

        task.wait(ATTACK_DELAY)
    end
end

while task.wait(TELEPORT_DELAY) do
    local mobs = getNearestMobs()

    for _, data in ipairs(mobs) do
        local mob = data.Model
        local mobRoot = getRoot(mob)

        if mobRoot and isMobAlive(mob) then
            teleportBesideMob(mobRoot)
            task.wait(0.025)
            attackMob(mob)
        end
    end
end
