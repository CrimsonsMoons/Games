    routeToggleControl = MainTab:ToggleButton(toggleOptions)
elseif type(MainTab.Toggle) == "function" then
    routeToggleControl = MainTab:Toggle(toggleOptions)
else
    routeWarn("No ToggleButton/Toggle method found in UI library.")
end

--// Runtime reconnect watcher
characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function()
    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false
    lastCharacterForPosition = nil
    lastCharacterPosition = nil

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    task.delay(0.25, function()
        if enabled then
            forceReconnectStart()
        end
    end)
end)

characterChangedConnection = LocalPlayer:GetPropertyChangedSignal("Character"):Connect(function()
    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false
    lastCharacterForPosition = nil
    lastCharacterPosition = nil

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    task.delay(0.25, function()
        if enabled then
            forceReconnectStart()
        end
    end)
end)

autoReconnectConnection = RunService.Heartbeat:Connect(function()
    if not enabled then return end

    local now = os.clock()
    if now - lastReconnectCheck < AUTO_RECONNECT_INTERVAL then return end
    lastReconnectCheck = now

    forceReconnectStart()
end)

Controller.Destroy = function()
    enabled = false
    fullStop()

    if characterAddedConnection then
        characterAddedConnection:Disconnect()
        characterAddedConnection = nil
    end

    if characterChangedConnection then
        characterChangedConnection:Disconnect()
        characterChangedConnection = nil
    end

    if autoReconnectConnection then
        autoReconnectConnection:Disconnect()
        autoReconnectConnection = nil
    end
end

--// Start if toggle default is ON
setEnabled(DEFAULT_ROUTE_ENABLED)
