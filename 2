UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Config.ToggleKey then
        Config.Enabled = not Config.Enabled
        State.CurrentTarget = nil
        
        warn(string.format(
            "[MobAura] %s (Health: %.0f%%)",
            Config.Enabled and "ENABLED" or "DISABLED",
            Player.GetHealthPercent() * 100
        ))
    end
end)

--//==================================================
--// MAIN LOOPS
--//==================================================

-- Movement Loop
RunService.PreSimulation:Connect(function(dt)
    if not Config.Enabled or not Player.IsAlive() then
        State.CurrentTarget = nil
        return
    end

    Movement.ApplyNoClip()
    Movement.ApplyAntiSit()
    Movement.PreventAFK()

    -- Smart retargeting
    if Targeting.ShouldRetarget(State.CurrentTarget) then
        State.CurrentTarget = Targeting.GetNearestMob()
    end

    if State.CurrentTarget and Mob.IsValid(State.CurrentTarget) then
        Movement.FlyAboveMob(dt, State.CurrentTarget)
    end
end)

-- Attack Loop
task.spawn(function()
    while task.wait(0.05) do
        if Config.Enabled and Player.IsAlive() then
            local attackCount = Combat.Attack()

            if attackCount > 0 then
                -- Burst mode: attack multiple times rapidly
                if Config.Combat.BurstMode and attackCount >= 2 then
                    for i = 1, Config.Combat.BurstCount - 1 do
                        task.wait(Config.Combat.BurstDelay)
                        Combat.Attack()
                    end
                end
                
                local delay = attackCount == 1 
                    and Config.Combat.SoloAttackDelay 
                    or Config.Combat.AttackDelay
                    
                Debug.Print("Attacked", attackCount, "mobs")
                task.wait(delay)
            else
                task.wait(0.3) -- Reduced idle wait from 0.5
            end
        else
            task.wait(0.3)
        end
    end
end)

