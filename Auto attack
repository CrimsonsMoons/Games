--// Settings
local RANGE = 35
local ATTACK_DELAY = 0.25

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folders
local MobsFolder = workspace:WaitForChild("Mobs", 9e9)

local function getRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function getMyRoot()
    local char = LocalPlayer.Character
    if not char then return nil end

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("RootPart")
        or char.PrimaryPart
end

local function isMobAlive(mob)
    local humanoid = mob:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return false
    end

    local health = mob:GetAttribute("Health")
        or mob:GetAttribute("NewHealth")
        or mob:GetAttribute("HP")

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function getNearbyMobs()
    local myRoot = getMyRoot()
    if not myRoot then return {} end

    local nearbyMobs = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if mob:IsA("Model") and isMobAlive(mob) then
            local mobRoot = getRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - myRoot.Position).Magnitude

                if distance <= RANGE then
                    table.insert(nearbyMobs, mob)
                end
            end
        end
    end

    return nearbyMobs
end

while task.wait(ATTACK_DELAY) do
    local mobs = getNearbyMobs()

    if #mobs > 0 then
        local args = {
            [1] = mobs
        }

        PlayerAttack:FireServer(unpack(args))
    end
end
