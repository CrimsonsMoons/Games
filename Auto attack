--// Settings
local RANGE = 500 -- how far it scans for mobs
local TELEPORT_HEIGHT = 4 -- how high above/near the mob you teleport
local TELEPORT_DELAY = 0.12 -- faster = lower number
local ATTACKS_PER_MOB = 2 -- attacks each mob before moving on
local ATTACK_DELAY = 0.04

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folder
local MobsFolder = workspace:WaitForChild("Mobs", 9e9)

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getMyRoot()
    local char = getCharacter()

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("RootPart")
        or char.PrimaryPart
end

local function getRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    local humanoid = mob:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return false
    end

    local health = mob:GetAttribute("Health")
        or mob:GetAttribute("NewHealth")
        or mob:GetAttribute("HP")

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function getMobsInRange()
    local myRoot = getMyRoot()
    if not myRoot then return {} end

    local mobs = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if mob:IsA("Model") and isMobAlive(mob) then
            local mobRoot = getRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - myRoot.Position).Magnitude

                if distance <= RANGE then
                    mobs[#mobs + 1] = {
                        Model = mob,
                        Root = mobRoot,
                        Distance = distance
                    }
                end
            end
        end
    end

    table.sort(mobs, function(a, b)
        return a.Distance < b.Distance
    end)

    return mobs
end

local function teleportToMob(mobRoot)
    local myRoot = getMyRoot()
    if not myRoot or not mobRoot then return end

    local targetPosition = mobRoot.Position + Vector3.new(0, TELEPORT_HEIGHT, 0)

    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero

    myRoot.CFrame = CFrame.lookAt(
        targetPosition,
        mobRoot.Position
    )
end

local function attackMob(mob)
    if not mob or not mob.Parent then return end

    for _ = 1, ATTACKS_PER_MOB do
        if not isMobAlive(mob) then break end

        PlayerAttack:FireServer({
            [1] = mob
        })

        task.wait(ATTACK_DELAY)
    end
end

while task.wait(TELEPORT_DELAY) do
    local mobs = getMobsInRange()

    for _, data in ipairs(mobs) do
        local mob = data.Model
        local mobRoot = getRoot(mob)

        if mobRoot and isMobAlive(mob) then
            teleportToMob(mobRoot)
            task.wait(0.05)
            attackMob(mob)
        end
    end
end
