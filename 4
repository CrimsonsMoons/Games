--// Settings
local RANGE = 100
local ATTACK_DELAY = 0.15
local MAX_MOBS_PER_ATTACK = 3

local MOVE_ENABLED = true
local MOVE_DISTANCE = 4 -- how close you stop near the mob
local MOVE_SPEED = 35 -- studs per second, lower = slower
local MOVE_Y_OFFSET = 0

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folder
local MobsFolder = workspace:WaitForChild("Mobs", 9e9)

local function getCharacter()
    return LocalPlayer.Character
end

local function getMyRoot()
    local character = getCharacter()
    if not character or not character.Parent then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character.PrimaryPart
end

local function getRoot(model)
    if not model or not model.Parent then
        return nil
    end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function isOwnedByPlayer(mob)
    if not mob or not mob.Parent then
        return true
    end

    local owner = mob:GetAttribute("Owner") or mob:GetAttribute("owner")

    if owner == nil then
        return false
    end

    if typeof(owner) == "Instance" and owner:IsA("Player") then
        return true
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        for _, player in ipairs(Players:GetPlayers()) do
            if owner == player.Name
                or owner == player.DisplayName
                or owner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    return owner == true
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    local humanoid = mob:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return false
    end

    local health = mob:GetAttribute("Health")
        or mob:GetAttribute("NewHealth")
        or mob:GetAttribute("HP")

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function isValidMob(mob)
    return mob
        and mob.Parent
        and mob:IsA("Model")
        and isMobAlive(mob)
        and not isOwnedByPlayer(mob)
        and getRoot(mob) ~= nil
end

local function getClosestMobData()
    local myRoot = getMyRoot()
    if not myRoot then
        return {}
    end

    local found = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) then
            local mobRoot = getRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - myRoot.Position).Magnitude

                if distance <= RANGE then
                    found[#found + 1] = {
                        Mob = mob,
                        Root = mobRoot,
                        Distance = distance
                    }
                end
            end
        end
    end

    table.sort(found, function(a, b)
        return a.Distance < b.Distance
    end)

    return found
end

local function getClosestMobs()
    local found = getClosestMobData()
    local closest = {}

    for i = 1, math.min(MAX_MOBS_PER_ATTACK, #found) do
        local mob = found[i].Mob

        if isValidMob(mob) then
            closest[#closest + 1] = mob
        end
    end

    return closest
end

local function moveTowardMob(mob)
    if not MOVE_ENABLED then return end
    if not isValidMob(mob) then return end

    local myRoot = getMyRoot()
    local mobRoot = getRoot(mob)

    if not myRoot or not mobRoot then return end

    local myPos = myRoot.Position
    local mobPos = mobRoot.Position

    local flatDirection = Vector3.new(
        mobPos.X - myPos.X,
        0,
        mobPos.Z - myPos.Z
    )

    if flatDirection.Magnitude <= MOVE_DISTANCE then
        return
    end

    local direction = flatDirection.Unit

    local targetPosition = Vector3.new(
        mobPos.X,
        mobPos.Y + MOVE_Y_OFFSET,
        mobPos.Z
    ) - direction * MOVE_DISTANCE

    local distance = (targetPosition - myPos).Magnitude
    local alpha = math.clamp((MOVE_SPEED * RunService.Heartbeat:Wait()) / distance, 0, 1)

    local newPosition = myPos:Lerp(targetPosition, alpha)

    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero

    myRoot.CFrame = CFrame.lookAt(
        newPosition,
        Vector3.new(mobPos.X, newPosition.Y, mobPos.Z)
    )
end

while task.wait(ATTACK_DELAY) do
    local success, closestData = pcall(getClosestMobData)

    if success and closestData and #closestData > 0 then
        local nearestMob = closestData[1].Mob

        if nearestMob and isValidMob(nearestMob) then
            pcall(function()
                moveTowardMob(nearestMob)
            end)
        end

        local mobs = {}

        for i = 1, math.min(MAX_MOBS_PER_ATTACK, #closestData) do
            local mob = closestData[i].Mob

            if isValidMob(mob) then
                mobs[#mobs + 1] = mob
            end
        end

        if #mobs > 0 then
            pcall(function()
                PlayerAttack:FireServer(mobs)
            end)
        end
    end
end
