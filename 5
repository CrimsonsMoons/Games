--// PlayerGui Text Finder
--// Searches for GUI text containing "Elysian Lance"
--// Also prints nearby parent/children so you can find the full GUI path

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local TARGET = "Elysian Lance"
local TARGET_LOWER = TARGET:lower()

local function safeGet(obj, prop)
    local ok, value = pcall(function()
        return obj[prop]
    end)

    if ok then
        return value
    end

    return nil
end

local function isTextObject(obj)
    return obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
end

local function getGuiText(obj)
    if not isTextObject(obj) then
        return ""
    end

    local text = tostring(safeGet(obj, "Text") or "")
    local contentText = tostring(safeGet(obj, "ContentText") or "")

    return text .. " " .. contentText
end

local function matches(obj)
    local fullText = getGuiText(obj):lower()
    return fullText:find(TARGET_LOWER, 1, true) ~= nil
end

local function printGuiInfo(obj)
    warn("======================================")
    warn("[FOUND] " .. TARGET)
    print("Object:", obj)
    print("Class:", obj.ClassName)
    print("Path:", obj:GetFullName())
    print("Text:", safeGet(obj, "Text"))
    print("ContentText:", safeGet(obj, "ContentText"))

    if obj.Parent then
        print("Parent:", obj.Parent:GetFullName(), "|", obj.Parent.ClassName)
    end

    local root = obj
    for _ = 1, 5 do
        if root.Parent and root.Parent ~= PlayerGui then
            root = root.Parent
        end
    end

    warn("[NEARBY GUI TREE]")
    print("Possible main GUI:", root:GetFullName(), "|", root.ClassName)

    for _, d in ipairs(root:GetDescendants()) do
        if isTextObject(d) then
            local t = tostring(safeGet(d, "Text") or "")
            local ct = tostring(safeGet(d, "ContentText") or "")

            if t ~= "" or ct ~= "" then
                print("TEXT:", d:GetFullName())
                print(" -> Text:", t)
                print(" -> ContentText:", ct)
            end
        end
    end

    warn("======================================")
end

local function scan()
    local found = 0

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if matches(obj) then
            found += 1
            printGuiInfo(obj)
        end
    end

    if found == 0 then
        warn("[NOT FOUND] No PlayerGui text currently contains:", TARGET)
    else
        warn("[DONE] Found", found, "matching text object(s).")
    end
end

scan()

--// Detect new GUI text appearing
PlayerGui.DescendantAdded:Connect(function(obj)
    task.wait(0.1)

    if isTextObject(obj) then
        if matches(obj) then
            printGuiInfo(obj)
        end

        obj:GetPropertyChangedSignal("Text"):Connect(function()
            if matches(obj) then
                printGuiInfo(obj)
            end
        end)
    end
end)

--// Detect existing GUI text changing
for _, obj in ipairs(PlayerGui:GetDescendants()) do
    if isTextObject(obj) then
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            if matches(obj) then
                printGuiInfo(obj)
            end
        end)
    end
end

--// Optional repeated scanner because some reward GUIs load slowly
task.spawn(function()
    while task.wait(1) do
        scan()
    end
end)
