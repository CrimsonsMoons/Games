local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PowerStat = LocalPlayer:WaitForChild("leaderstats"):WaitForChild("⚡️Power")

local KnitServices = ReplicatedStorage
    :WaitForChild("Packages", 9e9)
    :WaitForChild("_Index", 9e9)
    :WaitForChild("sleitnick_knit@1.5.1", 9e9)
    :WaitForChild("knit", 9e9)
    :WaitForChild("Services", 9e9)

local RunTrainRemote = KnitServices
    :WaitForChild("TrainService", 9e9)
    :WaitForChild("RE", 9e9)
    :WaitForChild("RunTrain", 9e9)

local GetWinsRemote = KnitServices
    :WaitForChild("FightService", 9e9)
    :WaitForChild("RE", 9e9)
    :WaitForChild("GetWinsEvent", 9e9)

local FightActivePart = workspace:WaitForChild("Areas")
    :WaitForChild("Area_1")
    :WaitForChild("FightParts")
    :WaitForChild("FightActivePart")

local WinGatesFolder = workspace:WaitForChild("Areas")
    :WaitForChild("Area_1")
    :WaitForChild("WinGates")

local Treadmills = {
    {0, "Treadmill_1_1"},
    {1000, "Treadmill_1_2"},
    {5000, "Treadmill_1_3"},
    {35000, "Treadmill_1_4"},
    {400000, "Treadmill_1_5"},
    {1000000, "Treadmill_1_6"},
    {4000000, "Treadmill_1_7"},
    {15000000, "Treadmill_1_8"},
    {50000000, "Treadmill_1_9"},
    {300000000, "Treadmill_1_10"},
    {1500000000, "Treadmill_1_11"},
    {5000000000, "Treadmill_1_12"},
}

local TrainDelay = 0.03
local FightDelay = 0.35
local WinBurstDelay = 0.08

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRoot()
    local character = getCharacter()
    return character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart")
end

local function getBestTreadmill(power)
    local chosen = Treadmills[1][2]

    for i = 1, #Treadmills do
        if power >= Treadmills[i][1] then
            chosen = Treadmills[i][2]
        else
            break
        end
    end

    return chosen
end

local function teleportToFightPart()
    local root = getRoot()
    root.CFrame = FightActivePart.CFrame + Vector3.new(0, 3, 0)
end

local function fireAllGatesAtOnce()
    for i = 1, 16 do
        local gate = WinGatesFolder:FindFirstChild("WinGate_" .. i)
        if gate then
            task.spawn(function()
                pcall(function()
                    GetWinsRemote:FireServer(gate.Name, gate.Position)
                end)
            end)
        end
    end
end

task.spawn(function()
    while true do
        local treadmill = getBestTreadmill(PowerStat.Value)

        pcall(function()
            RunTrainRemote:FireServer(treadmill)
        end)

        task.wait(TrainDelay)
    end
end)

task.spawn(function()
    while true do
        pcall(function()
            teleportToFightPart()
        end)

        task.wait(FightDelay)
    end
end)

task.spawn(function()
    while true do
        fireAllGatesAtOnce()
        task.wait(WinBurstDelay)
    end
end)
