--// Route points
local FIRST_Y = 370
local FIRST_POINT = Vector3.new(235, 370, 512)
local FINAL_POINT = Vector3.new(14, 517, 431)
local OVERHEAD_Y = 560

--// Speeds
local SPAWN_DELAY = 0.35
local Y_MOVE_SPEED = 24
local FIRST_POINT_SPEED = 28
local UP_SPEED = 50
local OVERHEAD_MOVE_SPEED = 28
local DROP_SPEED = 22
local TOLERANCE = 2

--// Loop delay at final point
local AUTO_RERUN_DELAY = 17

--// Route protection
local SOFT_ROUTE_CORRECTION_DISTANCE = 8
local HARD_OFF_ROUTE_DISTANCE = 45
local STUCK_TIME = 4
local STUCK_MIN_MOVE = 2.5
local SEGMENT_TIMEOUT_EXTRA = 8
local RESET_COOLDOWN = 5

--// Reconnect checks
local AUTO_RECONNECT_INTERVAL = 0.25
local START_RETRY_COOLDOWN = 0.75
local FINAL_RESTART_DISTANCE = 80
local SAME_CHARACTER_JUMP_DISTANCE = 75

local enabled = true

local activeMoveConnection
local noclipConnection
local characterAddedConnection
local characterChangedConnection
local autoReconnectConnection
local humanoidDiedConnection

local uiWindow
local uiTab
local uiLoaded = false

local routeToken = 0
local currentCharacter = nil
local routeRunning = false
local routeCompleted = false

local lastResetClock = 0
local lastStartAttempt = 0
local lastReconnectCheck = 0
local lastCharacterForPosition = nil
local lastCharacterPosition = nil

local startRoute

local function stopMove()
    if activeMoveConnection then
        activeMoveConnection:Disconnect()
        activeMoveConnection = nil
    end
end

local function stopNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

local function stopHumanoidDiedConnection()
    if humanoidDiedConnection then
        humanoidDiedConnection:Disconnect()
        humanoidDiedConnection = nil
    end
end

local function updateButton()
    -- UI lib toggles manage their own visual state.
end

local function setNoclip(character)
    if not character then return end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end
end

local function startNoclip(character)
    stopNoclip()

    noclipConnection = RunService.Stepped:Connect(function()
        if not enabled then
            stopNoclip()
            return
        end

        if not character or not character.Parent then
            stopNoclip()
            return
        end

        setNoclip(character)
    end)
end

local function getLookTarget(position)
    local flatFinal = Vector3.new(FINAL_POINT.X, position.Y, FINAL_POINT.Z)

    if (flatFinal - position).Magnitude < 1 then
        return position + Vector3.new(0, 0, -10)
    end

    return flatFinal
end

local function safeLookAt(position)
    return CFrame.lookAt(position, getLookTarget(position))
end

local function getClosestPointOnSegment(point, a, b)
    local ab = b - a
    local lengthSquared = ab:Dot(ab)

    if lengthSquared <= 0.001 then
        return a
    end

    local t = math.clamp((point - a):Dot(ab) / lengthSquared, 0, 1)
    return a + ab * t
end

local function softRestartRoute(character)
    if not enabled then return end
    if not character or not character.Parent then return end

    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    task.delay(0.2, function()
        if not enabled then return end
        if not character or not character.Parent then return end

        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            task.spawn(startRoute, character)
        end
    end)
end

local function resetCharacter()
    if not enabled then return end

    local now = os.clock()
    if now - lastResetClock < RESET_COOLDOWN then return end
    lastResetClock = now

    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Health = 0
    elseif character then
        character:BreakJoints()
    end

    --// If the game only teleports the same character instead of fully respawning,
    --// restart the route with that same character.
    task.delay(1.25, function()
        local sameCharacter = LocalPlayer.Character
        local root = sameCharacter and sameCharacter:FindFirstChild("HumanoidRootPart")
        local humanoid = sameCharacter and sameCharacter:FindFirstChildOfClass("Humanoid")

        if enabled and sameCharacter and root and humanoid and humanoid.Health > 0 then
            softRestartRoute(sameCharacter)
        end
    end)
end

local function moveTo(root, targetProvider, speed, token, onFinished)
    stopMove()

    local segmentStart = root.Position
    local segmentTarget = targetProvider(segmentStart)

    local segmentDistance = math.max((segmentTarget - segmentStart).Magnitude, 1)
    local segmentStartClock = os.clock()
    local segmentTimeout = (segmentDistance / math.max(speed, 1)) + SEGMENT_TIMEOUT_EXTRA

    local lastMovePosition = root.Position
    local lastMoveClock = os.clock()

    activeMoveConnection = RunService.Heartbeat:Connect(function(dt)
        if token ~= routeToken then
            stopMove()
            return
        end

        if not enabled then
            stopMove()
            return
        end

        if not root or not root.Parent then
            stopMove()
            return
        end

        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        local rawPosition = root.Position
        local closestOnRoute = getClosestPointOnSegment(rawPosition, segmentStart, segmentTarget)
        local offRouteDistance = (rawPosition - closestOnRoute).Magnitude

        if offRouteDistance > HARD_OFF_ROUTE_DISTANCE then
            resetCharacter()
            return
        end

        local currentPosition = closestOnRoute

        if offRouteDistance > SOFT_ROUTE_CORRECTION_DISTANCE then
            root.CFrame = safeLookAt(currentPosition)
        end

        local offset = segmentTarget - currentPosition
        local distance = offset.Magnitude

        if (currentPosition - lastMovePosition).Magnitude >= STUCK_MIN_MOVE then
            lastMovePosition = currentPosition
            lastMoveClock = os.clock()
        elseif os.clock() - lastMoveClock >= STUCK_TIME and distance > TOLERANCE + 3 then
            resetCharacter()
            return
        end

        if os.clock() - segmentStartClock > segmentTimeout and distance > TOLERANCE + 3 then
            resetCharacter()
            return
        end

        if distance <= TOLERANCE then
            root.CFrame = safeLookAt(segmentTarget)
            stopMove()

            if onFinished then
                task.defer(onFinished)
            end

            return
        end

        local step = math.min(speed * dt, distance)
        local newPosition = currentPosition + offset.Unit * step

        root.CFrame = safeLookAt(newPosition)
    end)
end

local function scheduleNextRun(character, finishedToken)
    task.delay(AUTO_RERUN_DELAY, function()
        if not enabled then return end
        if finishedToken ~= routeToken then return end
        if not character or not character.Parent then return end

        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            routeRunning = false
            routeCompleted = false
            currentCharacter = nil
            task.spawn(startRoute, character)
        end
    end)
end

startRoute = function(character)
    if not enabled then return end
    if routeRunning then return end
    if not character or not character.Parent then return end

    routeToken += 1
    local token = routeToken

    currentCharacter = character
    routeRunning = true
    routeCompleted = false

    stopMove()
    stopNoclip()

    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)

    if token ~= routeToken then
        routeRunning = false
        return
    end

    if not root or not humanoid or humanoid.Health <= 0 then
        currentCharacter = nil
        routeRunning = false
        return
    end

    stopHumanoidDiedConnection()

    humanoidDiedConnection = humanoid.Died:Connect(function()
        if currentCharacter == character then
            routeToken += 1
            routeRunning = false
            routeCompleted = false
            currentCharacter = nil
            stopMove()
            stopNoclip()
        end
    end)

    task.wait(SPAWN_DELAY)

    if token ~= routeToken then
        routeRunning = false
        return
    end

    if not enabled then
        routeRunning = false
        return
    end

    if not root.Parent or humanoid.Health <= 0 then
        currentCharacter = nil
        routeRunning = false
        return
    end

    startNoclip(character)
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    --// Step 1: go to Y = 370, keeping spawn X/Z
    moveTo(
        root,
        function(currentPosition)
            return Vector3.new(currentPosition.X, FIRST_Y, currentPosition.Z)
        end,
        Y_MOVE_SPEED,
        token,
        function()
            if token ~= routeToken then return end
            if not enabled or not root.Parent then return end

            --// Step 2: go to 235, 370, 512
            moveTo(
                root,
                function()
                    return FIRST_POINT
                end,
                FIRST_POINT_SPEED,
                token,
                function()
                    if token ~= routeToken then return end
                    if not enabled or not root.Parent then return end

                    --// Step 3: go straight up above ground
                    moveTo(
                        root,
                        function(currentPosition)
                            return Vector3.new(currentPosition.X, OVERHEAD_Y, currentPosition.Z)
                        end,
                        UP_SPEED,
                        token,
                        function()
                            if token ~= routeToken then return end
                            if not enabled or not root.Parent then return end

                            --// Step 4: move across overhead
                            moveTo(
                                root,
                                function()
                                    return Vector3.new(FINAL_POINT.X, OVERHEAD_Y, FINAL_POINT.Z)
                                end,
                                OVERHEAD_MOVE_SPEED,
                                token,
                                function()
                                    if token ~= routeToken then return end
                                    if not enabled or not root.Parent then return end

                                    --// Step 5: drop to final point
                                    moveTo(
                                        root,
                                        function()
                                            return FINAL_POINT
                                        end,
                                        DROP_SPEED,
                                        token,
                                        function()
                                            if token ~= routeToken then return end

                                            routeRunning = false
                                            routeCompleted = true
                                            currentCharacter = character

                                            if humanoid and humanoid.Parent then
                                                humanoid:ChangeState(Enum.HumanoidStateType.Running)
                                            end

                                            if enabled then
                                                startNoclip(character)
                                                scheduleNextRun(character, token)
                                            end
                                        end
                                    )
                                end
                            )
                        end
                    )
                end
            )
        end
    )
end

local function fullStop()
    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end

local function forceReconnectStart()
    if not enabled then return end

    local now = os.clock()
    if now - lastStartAttempt < START_RETRY_COOLDOWN then return end
    lastStartAttempt = now

    local character = LocalPlayer.Character

    if not character or not character.Parent then
        currentCharacter = nil
        routeRunning = false
        routeCompleted = false
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not root or not humanoid or humanoid.Health <= 0 then
        currentCharacter = nil
        routeRunning = false
        routeCompleted = false
        return
    end

    --// Same-character teleport-back detector
    if lastCharacterForPosition == character and lastCharacterPosition then
        local jumpDistance = (root.Position - lastCharacterPosition).Magnitude

        if routeRunning and jumpDistance > SAME_CHARACTER_JUMP_DISTANCE then
            softRestartRoute(character)
            lastCharacterPosition = root.Position
            return
        end
    end

    lastCharacterForPosition = character
    lastCharacterPosition = root.Position

    if currentCharacter ~= character then
        routeToken += 1
        stopMove()
        stopNoclip()
        stopHumanoidDiedConnection()

        currentCharacter = nil
        routeRunning = false
        routeCompleted = false

        task.spawn(startRoute, character)
        return
    end

    if routeCompleted and not routeRunning then
        local distanceFromFinal = (root.Position - FINAL_POINT).Magnitude

        if distanceFromFinal > FINAL_RESTART_DISTANCE then
            softRestartRoute(character)
            return
        end
    end

    if not routeRunning and not routeCompleted then
        task.spawn(startRoute, character)
    end
end

local function setEnabled(value)
    enabled = value
    updateButton()

    if enabled then
        currentCharacter = nil
        routeRunning = false
        routeCompleted = false
        lastCharacterForPosition = nil
        lastCharacterPosition = nil
        forceReconnectStart()
    else
        fullStop()
    end
end

local function safeMethod(obj, methodName, ...)
    if not obj then return false end

    local fn = obj[methodName]
    if type(fn) ~= "function" then return false end

    local args = { ... }

    local ok, result = pcall(function()
        return fn(obj, table.unpack(args))
    end)

    if ok then
        return true, result
    end

    ok, result = pcall(function()
        return fn(table.unpack(args))
    end)

    if ok then
        return true, result
    end

    return false
end

local function firstMethod(obj, methodNames, ...)
    for _, methodName in ipairs(methodNames) do
        local ok, result = safeMethod(obj, methodName, ...)
        if ok then
            return result, methodName
        end
    end
end

local function createMenuToggle(container, name, description, default, callback)
    local methods = { "newToggle", "CreateToggle", "AddToggle", "Toggle" }

    for _, methodName in ipairs(methods) do
        local fn = container and container[methodName]
        if type(fn) == "function" then
            local attempts = {
                { name, description, default, callback },
                { name, default, Color3.fromRGB(120, 90, 255), 0.25, callback },
                { name, default, callback },
                { name, description, callback, default },
                { { Name = name, Description = description, Default = default, Callback = callback } },
                { { Title = name, Desc = description, Default = default, Callback = callback } },
                { { Text = name, Default = default, Callback = callback } },
            }

            for _, args in ipairs(attempts) do
                local ok = pcall(function()
                    return fn(container, table.unpack(args))
                end)

                if ok then return true end

                ok = pcall(function()
                    return fn(table.unpack(args))
                end)

                if ok then return true end
            end
        end
    end

    return false
end

local function createMenuButton(container, name, description, callback)
    local methods = { "newButton", "CreateButton", "AddButton", "Button" }

    for _, methodName in ipairs(methods) do
        local fn = container and container[methodName]
        if type(fn) == "function" then
            local attempts = {
                { name, description, callback },
                { name, callback },
                { { Name = name, Description = description, Callback = callback } },
                { { Title = name, Desc = description, Callback = callback } },
                { { Text = name, Callback = callback } },
            }

            for _, args in ipairs(attempts) do
                local ok = pcall(function()
                    return fn(container, table.unpack(args))
                end)

                if ok then return true end

                ok = pcall(function()
                    return fn(table.unpack(args))
                end)

                if ok then return true end
            end
        end
    end

    return false
end

local function createMenuXDUI()
    local libraryUrl = "https://raw.githubusercontent.com/DestroyTheO/MenuXD/refs/heads/main/Main"

    local ok, library = pcall(function()
        return loadstring(game:HttpGet(libraryUrl))()
    end)

    if not ok or not library then
        warn("[CrimmyRoute] MenuXD UI failed to load. Route still starts automatically.")
        return
    end

    local window = firstMethod(library, { "Load" }, "CrimmyScriptz", "Default")
        or firstMethod(library, { "CreateWindow" }, "CrimmyScriptz", "Western Bridger", "CrimmyScriptz", "Default", false, "CrimmyRoute", "Default")
        or firstMethod(library, { "MakeWindow", "Window", "new" }, {
            Name = "CrimmyScriptz",
            Title = "CrimmyScriptz",
            SubTitle = "Route Controller",
            SaveConfig = false,
            ConfigFolder = "CrimmyRoute"
        })
        or library

    uiWindow = window

    local tab = firstMethod(library, { "newTab" }, "Route", "Default")
        or firstMethod(window, { "newTab", "CreateTab", "Tab", "AddTab" }, "Route", true, "Default")
        or window

    uiTab = tab

    local section = firstMethod(tab, { "CreateSection", "newSection", "Section", "AddSection" }, "Main") or tab

    createMenuToggle(section, "Route Loop", "Runs the route and repeats every 17 seconds.", enabled, function(value)
        setEnabled(value == true)
    end)

    createMenuButton(section, "Start Route Now", "Force starts the current route.", function()
        routeToken += 1
        currentCharacter = nil
        routeRunning = false
        routeCompleted = false
        stopMove()
        stopNoclip()
        forceReconnectStart()
    end)

    createMenuButton(section, "Stop Route", "Stops movement and noclip.", function()
        setEnabled(false)
    end)

    createMenuButton(section, "Restart Character", "Resets character and starts over.", function()
        resetCharacter()
    end)

    createMenuToggle(section, "Fullbright", "Keeps map bright.", true, function(value)
        pcall(function()
            Lighting.Brightness = value and 2 or 1
            Lighting.ClockTime = value and 14 or Lighting.ClockTime
            Lighting.FogEnd = value and 100000 or 1000
            Lighting.GlobalShadows = not value
            Lighting.OutdoorAmbient = value and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(127, 127, 127)
            Lighting.Ambient = value and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(127, 127, 127)
        end)
    end)

    uiLoaded = true
end

autoReconnectConnection = RunService.Heartbeat:Connect(function()
    if not enabled then return end

    local now = os.clock()
    if now - lastReconnectCheck < AUTO_RECONNECT_INTERVAL then return end
    lastReconnectCheck = now

    forceReconnectStart()
end)

characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
    routeToken += 1
    currentCharacter = nil
    routeRunning = false
    routeCompleted = false
    lastCharacterForPosition = nil
    lastCharacterPosition = nil

    stopMove()
    stopNoclip()
    stopHumanoidDiedConnection()

    task.delay(0.25, function()
        if enabled then
            forceReconnectStart()
        end
    end)
end)

