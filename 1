--//==================================================
--// SETTINGS
--//==================================================
local MOVE_SPEED = 150
local ABOVE_HEIGHT = 28
local ARRIVE_DISTANCE = 2

local NOCLIP_ENABLED = true -- added

local DODGE_ENABLED = true
local DODGE_RADIUS = 10
local DODGE_SPEED = 3.2
local DODGE_RANDOMNESS = 3
local DODGE_REFRESH = 0.45

local ATTACK_RANGE = 160
local ATTACK_DELAY = 0.22
local MAX_MOBS_PER_ATTACK = 3

local TARGET_REFRESH_RATE = 0.08
local SWITCH_TARGET_BUFFER = 10

local ZERO_VELOCITY = true
local FACE_MOB = true

--//==================================================
--// SERVICES
--//==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--//==================================================
--// REMOTE / FOLDER
--//==================================================
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

local MobsFolder = Workspace:WaitForChild("Mobs", 9e9)

--//==================================================
--// STATE
--//==================================================
local CurrentTarget = nil
local LastAttack = 0
local LastTargetRefresh = 0
local LastDodgeRefresh = 0
local DodgeOffset = Vector3.zero

--//==================================================
--// PLAYER HELPERS
--//==================================================
local function getChar()
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getChar()
    return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local char = getChar()
    if not char or not char.Parent then
        return nil
    end

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("RootPart")
        or char.PrimaryPart
end

local function isPlayerAlive()
    local hum = getHumanoid()
    return hum and hum.Health > 0
end

--//==================================================
--// NOCLIP
--//==================================================
local function applyNoClip()
    if not NOCLIP_ENABLED then
        return
    end

    local char = getChar()
    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end
end

--//==================================================
--// MOB HELPERS
--//==================================================
local function getMobRoot(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("RootPart")
        or mob:FindFirstChild("Torso")
        or mob:FindFirstChild("UpperTorso")
        or mob.PrimaryPart
        or mob:FindFirstChildWhichIsA("BasePart")
end

local function getMobHumanoid(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChildWhichIsA("Humanoid")
end

local function isOwnedByPlayer(mob)
    if not mob or not mob.Parent then
        return true
    end

    local owner =
        mob:GetAttribute("Owner")
        or mob:GetAttribute("owner")
        or mob:GetAttribute("OwnerId")
        or mob:GetAttribute("ownerId")
        or mob:GetAttribute("UserId")
        or mob:GetAttribute("userId")

    if owner == nil or owner == "" or owner == 0 then
        return false
    end

    if typeof(owner) == "Instance" then
        if owner:IsA("Player") then
            return true
        end

        if owner:IsA("Model") and Players:GetPlayerFromCharacter(owner) then
            return true
        end
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        local lowOwner = string.lower(owner)

        for _, player in ipairs(Players:GetPlayers()) do
            if lowOwner == string.lower(player.Name)
                or lowOwner == string.lower(player.DisplayName)
                or lowOwner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    return owner == true
end

local function getMobHealth(mob)
    local hum = getMobHumanoid(mob)
    if hum then
        return hum.Health
    end

    local attrs = {
        "Health",
        "health",
        "HP",
        "hp",
        "NewHealth",
        "CurrentHealth",
        "currentHealth"
    }

    for _, attr in ipairs(attrs) do
        local value = mob:GetAttribute(attr)

        if typeof(value) == "number" then
            return value
        end
    end

    return nil
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    local health = getMobHealth(mob)

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    local dead =
        mob:GetAttribute("Dead")
        or mob:GetAttribute("dead")
        or mob:GetAttribute("Killed")
        or mob:GetAttribute("killed")

    if dead == true then
        return false
    end

    return true
end

local function isValidMob(mob)
    if not mob or not mob.Parent then
        return false
    end

    if not mob:IsA("Model") then
        return false
    end

    if isOwnedByPlayer(mob) then
        return false
    end

    if not isMobAlive(mob) then
        return false
    end

    if not getMobRoot(mob) then
        return false
    end

    return true
end

--//==================================================
--// MOB SCANNING
--//==================================================
local function getSortedMobsFromPosition(originPosition, maxRange)
    local list = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - originPosition).Magnitude

                if distance <= maxRange then
                    list[#list + 1] = {
                        Mob = mob,
                        Root = mobRoot,
                        Distance = distance
                    }
                end
            end
        end
    end

    table.sort(list, function(a, b)
        return a.Distance < b.Distance
    end)

    return list
end

local function getNearestMobAnywhere()
    local root = getRoot()
    if not root then
        return nil
    end

    local sorted = getSortedMobsFromPosition(root.Position, math.huge)

    for _, data in ipairs(sorted) do
        if isValidMob(data.Mob) then
            return data.Mob
        end
    end

    return nil
end

local function getDistanceToMob(mob)
    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return math.huge
    end

    return (mobRoot.Position - root.Position).Magnitude
end

local function refreshTarget()
    if not isValidMob(CurrentTarget) then
        CurrentTarget = getNearestMobAnywhere()
        return
    end

    local nearest = getNearestMobAnywhere()

    if nearest and nearest ~= CurrentTarget then
        local currentDistance = getDistanceToMob(CurrentTarget)
        local nearestDistance = getDistanceToMob(nearest)

        if nearestDistance + SWITCH_TARGET_BUFFER < currentDistance then
            CurrentTarget = nearest
        end
    end
end

--//==================================================
--// DODGE LOGIC
--//==================================================
local function updateDodgeOffset(mobRoot)
    if not DODGE_ENABLED or not mobRoot then
        DodgeOffset = Vector3.zero
        return
    end

    local now = tick()

    if now - LastDodgeRefresh < DODGE_REFRESH then
        return
    end

    LastDodgeRefresh = now

    local angle = now * DODGE_SPEED

    local orbitOffset = Vector3.new(
        math.cos(angle) * DODGE_RADIUS,
        0,
        math.sin(angle) * DODGE_RADIUS
    )

    local randomOffset = Vector3.new(
        math.random(-DODGE_RANDOMNESS, DODGE_RANDOMNESS),
        0,
        math.random(-DODGE_RANDOMNESS, DODGE_RANDOMNESS)
    )

    DodgeOffset = orbitOffset + randomOffset
end

--//==================================================
--// CFRAME FLY ABOVE + DODGE TARGET
--//==================================================
local function flyAboveTarget(dt, mob)
    if not isPlayerAlive() or not isValidMob(mob) then
        return
    end

    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return
    end

    updateDodgeOffset(mobRoot)

    local targetPosition =
        mobRoot.Position
        + Vector3.new(0, ABOVE_HEIGHT, 0)
        + DodgeOffset

    local currentPosition = root.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    if ZERO_VELOCITY then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    local newPosition

    if distance <= ARRIVE_DISTANCE then
        newPosition = targetPosition
    else
        local direction = offset.Unit
        local moveAmount = math.min(MOVE_SPEED * dt, distance)
        newPosition = currentPosition + direction * moveAmount
    end

    if FACE_MOB then
        root.CFrame = CFrame.lookAt(newPosition, mobRoot.Position)
    else
        root.CFrame = CFrame.new(newPosition)
    end
end

--//==================================================
--// KILL AURA
--//==================================================
local function getAttackMobs()
    local root = getRoot()
    if not root then
        return {}
    end

    local sorted = getSortedMobsFromPosition(root.Position, ATTACK_RANGE)
    local mobs = {}

    for i = 1, math.min(MAX_MOBS_PER_ATTACK, #sorted) do
        local mob = sorted[i].Mob

        if isValidMob(mob) then
            mobs[#mobs + 1] = mob
        end
    end

    return mobs
end

local function attackClosestMobs()
    local mobs = getAttackMobs()

    if #mobs <= 0 then
        return
    end

    pcall(function()
        PlayerAttack:FireServer(mobs)
    end)
end

--//==================================================
--// MAIN LOOP
--//==================================================
RunService.PreSimulation:Connect(function(dt)
    applyNoClip()

    if not isPlayerAlive() then
        CurrentTarget = nil
        return
    end

    local root = getRoot()
    if not root then
        CurrentTarget = nil
        return
    end

    local now = tick()

    if now - LastTargetRefresh >= TARGET_REFRESH_RATE then
        LastTargetRefresh = now

        pcall(function()
            refreshTarget()
        end)
    end

    if CurrentTarget and isValidMob(CurrentTarget) then
        pcall(function()
            flyAboveTarget(dt, CurrentTarget)
        end)
    end

    if now - LastAttack >= ATTACK_DELAY then
        LastAttack = now

        pcall(function()
            attackClosestMobs()
        end)
    end
end)
