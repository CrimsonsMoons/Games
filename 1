--//==================================================
--// SMART MOB AURA + CFRAME FLY + NOCLIP + IMPROVED ATTACK
--// Uses CFrame-style movement like your uploaded fly script.
--//==================================================

--//==================================================
--// CONFIG
--//==================================================
local CONFIG = {
    Enabled = true,

    -- Movement
    MoveSpeed = 165,
    AboveHeight = 35,
    ArriveDistance = 2.25,
    FaceMob = true,
    ZeroVelocity = true,

    -- Dodge / orbit
    DodgeEnabled = true,
    DodgeRadius = 13,
    DodgeSpeed = 3.7,
    DodgeRandomness = 4,
    DodgeRefresh = 0.35,

    -- Improved attack system
    AttackRange = 220,
    AttackDelay = 0.10, -- .1 speed
    MaxMobsPerAttack = 5, -- attack 5 mobs

    -- Targeting
    TargetRefreshRate = 0.06,
    SwitchTargetBuffer = 12,

    -- Safety
    NoClip = true,
    AntiSit = true,

    -- GUI / controls
    ToggleKey = Enum.KeyCode.N,
    GuiToggleKey = Enum.KeyCode.RightControl,
}

--//==================================================
--// SERVICES
--//==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--//==================================================
--// REMOTE / FOLDER
--//==================================================
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

local MobsFolder = Workspace:WaitForChild("Mobs", 9e9)

--//==================================================
--// STATE
--//==================================================
local State = {
    CurrentTarget = nil,

    LastTargetRefresh = 0,
    LastDodgeRefresh = 0,
    DodgeOffset = Vector3.zero,

    LastMobCount = 0,
    LastAttackCount = 0,
    Status = "Starting...",

    OriginalCollision = {},
}

local AttackState = {
    LastFire = 0,
    FailCount = 0,
    DynamicDelay = CONFIG.AttackDelay,
    LastGoodAttack = 0,
}

--//==================================================
--// PLAYER HELPERS
--//==================================================
local function getChar()
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getChar()
    return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local char = getChar()
    if not char or not char.Parent then
        return nil
    end

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("RootPart")
        or char.PrimaryPart
end

local function isPlayerAlive()
    local hum = getHumanoid()
    return hum and hum.Health > 0
end

--//==================================================
--// MOB HELPERS
--//==================================================
local function getMobRoot(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("RootPart")
        or mob:FindFirstChild("Torso")
        or mob:FindFirstChild("UpperTorso")
        or mob.PrimaryPart
        or mob:FindFirstChildWhichIsA("BasePart")
end

local function getMobHumanoid(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChildWhichIsA("Humanoid")
end

local function getMobHealth(mob)
    local hum = getMobHumanoid(mob)

    if hum then
        return hum.Health
    end

    local attrs = {
        "Health",
        "health",
        "HP",
        "hp",
        "NewHealth",
        "CurrentHealth",
        "currentHealth",
        "Life",
        "life"
    }

    for _, attr in ipairs(attrs) do
        local value = mob:GetAttribute(attr)

        if typeof(value) == "number" then
            return value
        end
    end

    return nil
end

local function isMobDeadByAttribute(mob)
    local deadAttrs = {
        "Dead",
        "dead",
        "Killed",
        "killed",
        "IsDead",
        "isDead",
        "Died",
        "died"
    }

    for _, attr in ipairs(deadAttrs) do
        if mob:GetAttribute(attr) == true then
            return true
        end
    end

    return false
end

local function isOwnedByPlayer(mob)
    if not mob or not mob.Parent then
        return true
    end

    local owner =
        mob:GetAttribute("Owner")
        or mob:GetAttribute("owner")
        or mob:GetAttribute("OwnerId")
        or mob:GetAttribute("ownerId")
        or mob:GetAttribute("UserId")
        or mob:GetAttribute("userId")
        or mob:GetAttribute("Summoner")
        or mob:GetAttribute("summoner")

    if owner == nil or owner == "" or owner == 0 then
        return false
    end

    if typeof(owner) == "Instance" then
        if owner:IsA("Player") then
            return true
        end

        if owner:IsA("Model") and Players:GetPlayerFromCharacter(owner) then
            return true
        end
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        local lowerOwner = string.lower(owner)

        for _, player in ipairs(Players:GetPlayers()) do
            if lowerOwner == string.lower(player.Name)
                or lowerOwner == string.lower(player.DisplayName)
                or lowerOwner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    return owner == true
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    if isMobDeadByAttribute(mob) then
        return false
    end

    local health = getMobHealth(mob)

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function isValidMob(mob)
    if not mob or not mob.Parent then
        return false
    end

    if not mob:IsA("Model") then
        return false
    end

    if isOwnedByPlayer(mob) then
        return false
    end

    if not isMobAlive(mob) then
        return false
    end

    if not getMobRoot(mob) then
        return false
    end

    return true
end

--//==================================================
--// SCANNING / SORTING
--//==================================================
local function getSortedMobsFromPosition(originPosition, maxRange)
    local list = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - originPosition).Magnitude

                if distance <= maxRange then
                    list[#list + 1] = {
                        Mob = mob,
                        Root = mobRoot,
                        Distance = distance,
                        Health = getMobHealth(mob) or math.huge,
                    }
                end
            end
        end
    end

    table.sort(list, function(a, b)
        -- If close in distance, target lower HP first
        if math.abs(a.Distance - b.Distance) <= 3 then
            return a.Health < b.Health
        end

        return a.Distance < b.Distance
    end)

    return list
end

local function getNearestMobAnywhere()
    local root = getRoot()
    if not root then
        return nil
    end

    local sorted = getSortedMobsFromPosition(root.Position, math.huge)
    State.LastMobCount = #sorted

    for _, data in ipairs(sorted) do
        if isValidMob(data.Mob) then
            return data.Mob
        end
    end

    return nil
end

local function getDistanceToMob(mob)
    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return math.huge
    end

    return (mobRoot.Position - root.Position).Magnitude
end

local function refreshTarget()
    if not CONFIG.Enabled then
        State.CurrentTarget = nil
        return
    end

    if not isValidMob(State.CurrentTarget) then
        State.CurrentTarget = getNearestMobAnywhere()
        return
    end

    local nearest = getNearestMobAnywhere()

    if nearest and nearest ~= State.CurrentTarget then
        local currentDistance = getDistanceToMob(State.CurrentTarget)
        local nearestDistance = getDistanceToMob(nearest)

        if nearestDistance + CONFIG.SwitchTargetBuffer < currentDistance then
            State.CurrentTarget = nearest
        end
    end
end

--//==================================================
--// NOCLIP / ANTI-SIT
--//==================================================
local function saveCollision(part)
    if State.OriginalCollision[part] == nil then
        State.OriginalCollision[part] = part.CanCollide
    end
end

local function applyNoClip()
    if not CONFIG.NoClip or not CONFIG.Enabled then
        return
    end

    local char = getChar()
    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            saveCollision(obj)
            obj.CanCollide = false
        end
    end
end

local function restoreCollision()
    for part, oldValue in pairs(State.OriginalCollision) do
        if part and part.Parent then
            part.CanCollide = oldValue
        end
    end

    table.clear(State.OriginalCollision)
end

local function applyAntiSit()
    if not CONFIG.AntiSit or not CONFIG.Enabled then
        return
    end

    local hum = getHumanoid()

    if hum and hum.Sit then
        hum.Sit = false
    end
end

local function freezeVelocity(root)
    if not root or not CONFIG.ZeroVelocity then
        return
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

--//==================================================
--// DODGE / ORBIT
--//==================================================
local function updateDodgeOffset(mobRoot)
    if not CONFIG.DodgeEnabled or not mobRoot then
        State.DodgeOffset = Vector3.zero
        return
    end

    local now = tick()

    if now - State.LastDodgeRefresh < CONFIG.DodgeRefresh then
        return
    end

    State.LastDodgeRefresh = now

    local angle = now * CONFIG.DodgeSpeed

    local orbitOffset = Vector3.new(
        math.cos(angle) * CONFIG.DodgeRadius,
        0,
        math.sin(angle) * CONFIG.DodgeRadius
    )

    local randomOffset = Vector3.new(
        math.random(-CONFIG.DodgeRandomness, CONFIG.DodgeRandomness),
        0,
        math.random(-CONFIG.DodgeRandomness, CONFIG.DodgeRandomness)
    )

    State.DodgeOffset = orbitOffset + randomOffset
end

--//==================================================
--// CFRAME FLY ABOVE TARGET
--//==================================================
local function flyAboveTarget(dt, mob)
    if not CONFIG.Enabled then
        return
    end

    if not isPlayerAlive() or not isValidMob(mob) then
        return
    end

    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return
    end

    updateDodgeOffset(mobRoot)
    freezeVelocity(root)

    local targetPosition =
        mobRoot.Position
        + Vector3.new(0, CONFIG.AboveHeight, 0)
        + State.DodgeOffset

    local currentPosition = root.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    local newPosition

    if distance <= CONFIG.ArriveDistance then
        newPosition = targetPosition
    else
        local direction = offset.Unit
        local moveAmount = math.min(CONFIG.MoveSpeed * dt, distance)
        newPosition = currentPosition + direction * moveAmount
    end

    if CONFIG.FaceMob then
        root.CFrame = CFrame.lookAt(newPosition, mobRoot.Position)
    else
        root.CFrame = CFrame.new(newPosition)
    end
end

--//==================================================
--// IMPROVED ATTACK SYSTEM
--//==================================================
local function uniqueInsert(list, seen, mob)
    if not mob or seen[mob] then
        return
    end

    if not isValidMob(mob) then
        return
    end

    seen[mob] = true
    list[#list + 1] = mob
end

local function getAttackOrigin()
    local root = getRoot()

    -- Best origin is the current target so aura stays accurate while flying above it.
    if isValidMob(State.CurrentTarget) then
        local targetRoot = getMobRoot(State.CurrentTarget)

        if targetRoot then
            return targetRoot.Position
        end
    end

    if root then
        return root.Position
    end

    return nil
end

local function scoreMobForAttack(mob, originPosition)
    local mobRoot = getMobRoot(mob)

    if not mobRoot then
        return math.huge
    end

    local distance = (mobRoot.Position - originPosition).Magnitude
    local health = getMobHealth(mob) or math.huge

    -- Lower score = higher priority.
    -- Distance is main priority. Low HP gets slight priority.
    return distance + math.clamp(health / 100, 0, 15)
end

local function getSmartAttackMobs()
    local origin = getAttackOrigin()

    if not origin then
        return {}
    end

    local candidates = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - origin).Magnitude

                if distance <= CONFIG.AttackRange then
                    candidates[#candidates + 1] = {
                        Mob = mob,
                        Score = scoreMobForAttack(mob, origin),
                        Distance = distance,
                    }
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Score < b.Score
    end)

    local final = {}
    local seen = {}

    -- Force current target first
    if isValidMob(State.CurrentTarget) then
        local targetRoot = getMobRoot(State.CurrentTarget)

        if targetRoot and (targetRoot.Position - origin).Magnitude <= CONFIG.AttackRange then
            uniqueInsert(final, seen, State.CurrentTarget)
        end
    end

    -- Fill up to MaxMobsPerAttack
    for _, data in ipairs(candidates) do
        if #final >= CONFIG.MaxMobsPerAttack then
            break
        end

        uniqueInsert(final, seen, data.Mob)
    end

    -- Final recheck before remote fire
    local clean = {}

    for _, mob in ipairs(final) do
        if isValidMob(mob) then
            clean[#clean + 1] = mob
        end
    end

    return clean
end

local function fireAttackRemote(mobs)
    if #mobs <= 0 then
        return false
    end

    local success = pcall(function()
        PlayerAttack:FireServer(mobs)
    end)

    if success then
        AttackState.FailCount = 0
        AttackState.DynamicDelay = CONFIG.AttackDelay
        AttackState.LastGoodAttack = tick()

        State.LastAttackCount = #mobs
        State.Status = "Attacking " .. tostring(#mobs) .. " mobs"

        return true
    end

    AttackState.FailCount += 1

    -- Backoff if remote starts failing
    AttackState.DynamicDelay = math.clamp(
        CONFIG.AttackDelay + (AttackState.FailCount * 0.08),
        CONFIG.AttackDelay,
        0.75
    )

    State.Status = "Remote failed. Backing off."
    State.LastAttackCount = 0

    return false
end

local function attackClosestMobs()
    if not CONFIG.Enabled then
        return
    end

    local now = tick()

    if now - AttackState.LastFire < AttackState.DynamicDelay then
        return
    end

    AttackState.LastFire = now

    local mobs = getSmartAttackMobs()

    if #mobs <= 0 then
        State.LastAttackCount = 0
        State.Status = "No mobs in attack range"
        return
    end

    fireAttackRemote(mobs)
end

