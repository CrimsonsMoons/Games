--// INPUT
--//==================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        CurrentTarget = nil
        LastStatus = ENABLED and "Enabled" or "Disabled"
        warn("[SmartAura] Enabled:", ENABLED)
    end

    if input.KeyCode == GUI_TOGGLE_KEY then
        if Gui then
            Gui.Enabled = not Gui.Enabled
        end
    end
end)

--//==================================================
--// RESPAWN
--//==================================================
LocalPlayer.CharacterAdded:Connect(function()
    CurrentTarget = nil
    CurrentRoomIndex = 1
    LastTargetName = "None"
    LastRoomName = "None"
    LastStatus = "Respawned"
end)

--//==================================================
--// MOVEMENT LOOP
--//==================================================
RunService.PreSimulation:Connect(function(dt)
    updateGui()

    if not ENABLED then
        return
    end

    if not isPlayerAlive() then
        CurrentTarget = nil
        return
    end

    applyNoClip()
    applyAntiSit()

    local now = tick()

    if now - LastTargetRefresh >= TargetRefreshRate then
        LastTargetRefresh = now
        pcall(refreshTarget)
    end

    if CurrentTarget and isValidMob(CurrentTarget) then
        pcall(function()
            flyAboveMob(dt, CurrentTarget)
        end)
    end

    recoverMobLimit()
end)

--//==================================================
--// ATTACK WORKERS
--//==================================================
local function getCurrentAttackDelay()
    local mobs = getClosestAttackMobs()

    if #mobs == 1 then
        return SOLO_ATTACK_DELAY
    end

    return ATTACK_DELAY
end

local function startAttackWorker(workerName, startDelay)
    task.spawn(function()
        task.wait(startDelay)

        while task.wait(0.05) do
            if ENABLED then
                local mobs = getClosestAttackMobs()

                if #mobs > 0 then
                    attackMobs(workerName)
                    task.wait(getCurrentAttackDelay())
                else
                    LastAttackCount = 0
                    task.wait(0.5)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

startAttackWorker("Loop1", 0)

if OVERLAP_ATTACK_LOOPS then
    startAttackWorker("Loop2", ATTACK_DELAY / 2)
end
