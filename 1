local Gui, StatusLabel = makeGui()

local function updateGui()
    if not StatusLabel then
        return
    end

    local targetName = "None"
    local distance = "N/A"

    if isValidMob(State.CurrentTarget) then
        targetName = State.CurrentTarget.Name
        distance = tostring(math.floor(getDistanceToMob(State.CurrentTarget)))
    end

    StatusLabel.Text =
        "Enabled: " .. tostring(CONFIG.Enabled) ..
        "\nTarget: " .. targetName ..
        "\nDistance: " .. distance ..
        "\nDetected mobs: " .. tostring(State.LastMobCount) ..
        "\nAttacking: " .. tostring(State.LastAttackCount) .. "/" .. tostring(CONFIG.MaxMobsPerAttack) ..
        "\nDelay: " .. string.format("%.2f", AttackState.DynamicDelay) ..
        "\nHeight: " .. tostring(CONFIG.AboveHeight) ..
        "\nMove speed: " .. tostring(CONFIG.MoveSpeed) ..
        "\nStatus: " .. tostring(State.Status)
end

--//==================================================
--// INPUT
--//==================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == CONFIG.ToggleKey then
        CONFIG.Enabled = not CONFIG.Enabled

        if not CONFIG.Enabled then
            State.CurrentTarget = nil
            State.DodgeOffset = Vector3.zero
            State.LastAttackCount = 0
            State.Status = "Disabled"
            restoreCollision()
        else
            State.Status = "Enabled"
        end
    end

    if input.KeyCode == CONFIG.GuiToggleKey then
        if Gui then
            Gui.Enabled = not Gui.Enabled
        end
    end
end)

--//==================================================
--// RESPAWN HANDLING
--//==================================================
LocalPlayer.CharacterAdded:Connect(function()
    State.CurrentTarget = nil
    State.DodgeOffset = Vector3.zero
    State.LastAttackCount = 0
    State.Status = "Respawned"
    table.clear(State.OriginalCollision)
end)

--//==================================================
--// MAIN LOOP
--//==================================================
RunService.PreSimulation:Connect(function(dt)
    if CONFIG.Enabled then
        applyNoClip()
        applyAntiSit()
    end

    if not CONFIG.Enabled then
        updateGui()
        return
    end

    if not isPlayerAlive() then
        State.CurrentTarget = nil
        updateGui()
        return
    end

    local root = getRoot()

    if not root then
        State.CurrentTarget = nil
        updateGui()
        return
    end

    local now = tick()

    if now - State.LastTargetRefresh >= CONFIG.TargetRefreshRate then
        State.LastTargetRefresh = now

        pcall(function()
            refreshTarget()
        end)
    end

    if State.CurrentTarget and isValidMob(State.CurrentTarget) then
        pcall(function()
            flyAboveTarget(dt, State.CurrentTarget)
        end)
    else
        State.Status = "Searching for mobs..."
    end

    -- New attack system handles its own .10 delay
    pcall(function()
        attackClosestMobs()
    end)

    updateGui()
end)
