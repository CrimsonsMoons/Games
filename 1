--//==================================================
--// SMART MOB AURA + CFRAME FLY + NOCLIP + GUI
--// Attacks 5 closest mobs every 0.15 seconds
--//==================================================

--//==================================================
--// SETTINGS
--//==================================================
local CONFIG = {
    Enabled = true,

    -- Movement
    MoveSpeed = 165,
    AboveHeight = 35,
    ArriveDistance = 2.25,
    FaceMob = true,
    ZeroVelocity = true,

    -- Dodge / orbit
    DodgeEnabled = true,
    DodgeRadius = 13,
    DodgeSpeed = 3.7,
    DodgeRandomness = 4,
    DodgeRefresh = 0.35,

    -- Aura
    AttackRange = 190,
    AttackDelay = 0.15,
    MaxMobsPerAttack = 5,

    -- Targeting
    TargetRefreshRate = 0.06,
    SwitchTargetBuffer = 12,
    LostTargetDistance = math.huge,

    -- Safety
    NoClip = true,
    AntiSit = true,

    -- GUI / controls
    ToggleKey = Enum.KeyCode.N,
    GuiToggleKey = Enum.KeyCode.RightControl,
}

--//==================================================
--// SERVICES
--//==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--//==================================================
--// REMOTE / FOLDER
--//==================================================
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

local MobsFolder = Workspace:WaitForChild("Mobs", 9e9)

--//==================================================
--// STATE
--//==================================================
local State = {
    CurrentTarget = nil,
    LastAttack = 0,
    LastTargetRefresh = 0,
    LastDodgeRefresh = 0,
    DodgeOffset = Vector3.zero,

    LastMobCount = 0,
    LastAttackCount = 0,
    Status = "Starting...",
    OriginalCollision = {},
}

--//==================================================
--// PLAYER HELPERS
--//==================================================
local function getChar()
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getChar()
    return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local char = getChar()
    if not char or not char.Parent then
        return nil
    end

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("RootPart")
        or char.PrimaryPart
end

local function isPlayerAlive()
    local hum = getHumanoid()
    return hum and hum.Health > 0
end

--//==================================================
--// MOB HELPERS
--//==================================================
local function getMobRoot(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("RootPart")
        or mob:FindFirstChild("Torso")
        or mob:FindFirstChild("UpperTorso")
        or mob.PrimaryPart
        or mob:FindFirstChildWhichIsA("BasePart")
end

local function getMobHumanoid(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChildWhichIsA("Humanoid")
end

local function getMobHealth(mob)
    local hum = getMobHumanoid(mob)

    if hum then
        return hum.Health
    end

    local attrs = {
        "Health",
        "health",
        "HP",
        "hp",
        "NewHealth",
        "CurrentHealth",
        "currentHealth",
        "Life",
        "life"
    }

    for _, attr in ipairs(attrs) do
        local value = mob:GetAttribute(attr)

        if typeof(value) == "number" then
            return value
        end
    end

    return nil
end

local function isMobDeadByAttribute(mob)
    local deadAttrs = {
        "Dead",
        "dead",
        "Killed",
        "killed",
        "IsDead",
        "isDead",
        "Died",
        "died"
    }

    for _, attr in ipairs(deadAttrs) do
        if mob:GetAttribute(attr) == true then
            return true
        end
    end

    return false
end

local function isOwnedByPlayer(mob)
    if not mob or not mob.Parent then
        return true
    end

    local owner =
        mob:GetAttribute("Owner")
        or mob:GetAttribute("owner")
        or mob:GetAttribute("OwnerId")
        or mob:GetAttribute("ownerId")
        or mob:GetAttribute("UserId")
        or mob:GetAttribute("userId")
        or mob:GetAttribute("Summoner")
        or mob:GetAttribute("summoner")

    if owner == nil or owner == "" or owner == 0 then
        return false
    end

    if typeof(owner) == "Instance" then
        if owner:IsA("Player") then
            return true
        end

        if owner:IsA("Model") and Players:GetPlayerFromCharacter(owner) then
            return true
        end
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        local lowerOwner = string.lower(owner)

        for _, player in ipairs(Players:GetPlayers()) do
            if lowerOwner == string.lower(player.Name)
                or lowerOwner == string.lower(player.DisplayName)
                or lowerOwner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    return owner == true
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    if isMobDeadByAttribute(mob) then
        return false
    end

    local health = getMobHealth(mob)

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function isValidMob(mob)
    if not mob or not mob.Parent then
        return false
    end

    if not mob:IsA("Model") then
        return false
    end

    if isOwnedByPlayer(mob) then
        return false
    end

    if not isMobAlive(mob) then
        return false
    end

    if not getMobRoot(mob) then
        return false
    end

    return true
end

--//==================================================
--// SCANNING / SORTING
--//==================================================
local function getSortedMobsFromPosition(originPosition, maxRange)
    local list = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - originPosition).Magnitude

                if distance <= maxRange then
                    list[#list + 1] = {
                        Mob = mob,
                        Root = mobRoot,
                        Distance = distance,
                        Health = getMobHealth(mob) or math.huge,
                    }
                end
            end
        end
    end

    table.sort(list, function(a, b)
        if math.abs(a.Distance - b.Distance) <= 3 then
            return a.Health < b.Health
        end

        return a.Distance < b.Distance
    end)

    return list
end

local function getNearestMobAnywhere()
    local root = getRoot()
    if not root then
        return nil
    end

    local sorted = getSortedMobsFromPosition(root.Position, math.huge)
    State.LastMobCount = #sorted

    for _, data in ipairs(sorted) do
        if isValidMob(data.Mob) then
            return data.Mob
        end
    end

    return nil
end

local function getDistanceToMob(mob)
    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return math.huge
    end

    return (mobRoot.Position - root.Position).Magnitude
end

local function refreshTarget()
    if not CONFIG.Enabled then
        State.CurrentTarget = nil
        return
    end

    if not isValidMob(State.CurrentTarget) then
        State.CurrentTarget = getNearestMobAnywhere()
        return
    end

    local nearest = getNearestMobAnywhere()

    if nearest and nearest ~= State.CurrentTarget then
        local currentDistance = getDistanceToMob(State.CurrentTarget)
        local nearestDistance = getDistanceToMob(nearest)

        if nearestDistance + CONFIG.SwitchTargetBuffer < currentDistance then
            State.CurrentTarget = nearest
        end
    end
end

--//==================================================
--// NOCLIP / CHARACTER SAFETY
--//==================================================
local function saveCollision(part)
    if State.OriginalCollision[part] == nil then
        State.OriginalCollision[part] = part.CanCollide
    end
end

local function applyNoClip()
    if not CONFIG.NoClip or not CONFIG.Enabled then
        return
    end

    local char = getChar()
    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            saveCollision(obj)
            obj.CanCollide = false
        end
    end
end

local function restoreCollision()
    for part, oldValue in pairs(State.OriginalCollision) do
        if part and part.Parent then
            part.CanCollide = oldValue
        end
    end

    table.clear(State.OriginalCollision)
end

local function applyAntiSit()
    if not CONFIG.AntiSit or not CONFIG.Enabled then
        return
    end

    local hum = getHumanoid()

    if hum and hum.Sit then
        hum.Sit = false
    end
end

local function freezeVelocity(root)
    if not root or not CONFIG.ZeroVelocity then
        return
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

--//==================================================
--// DODGE / ORBIT
--//==================================================
local function updateDodgeOffset(mobRoot)
    if not CONFIG.DodgeEnabled or not mobRoot then
        State.DodgeOffset = Vector3.zero
        return
    end

    local now = tick()

    if now - State.LastDodgeRefresh < CONFIG.DodgeRefresh then
        return
    end

    State.LastDodgeRefresh = now

    local angle = now * CONFIG.DodgeSpeed

    local orbitOffset = Vector3.new(
        math.cos(angle) * CONFIG.DodgeRadius,
        0,
        math.sin(angle) * CONFIG.DodgeRadius
    )

    local randomOffset = Vector3.new(
        math.random(-CONFIG.DodgeRandomness, CONFIG.DodgeRandomness),
        0,
        math.random(-CONFIG.DodgeRandomness, CONFIG.DodgeRandomness)
    )

    State.DodgeOffset = orbitOffset + randomOffset
end

--//==================================================
--// CFRAME FLY ABOVE TARGET
--//==================================================
local function flyAboveTarget(dt, mob)
    if not CONFIG.Enabled then
        return
    end

    if not isPlayerAlive() or not isValidMob(mob) then
        return
    end

    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return
    end

    updateDodgeOffset(mobRoot)
    freezeVelocity(root)

    local targetPosition =
        mobRoot.Position
        + Vector3.new(0, CONFIG.AboveHeight, 0)
        + State.DodgeOffset

    local currentPosition = root.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    local newPosition

    if distance <= CONFIG.ArriveDistance then
        newPosition = targetPosition
    else
        local direction = offset.Unit
        local moveAmount = math.min(CONFIG.MoveSpeed * dt, distance)
        newPosition = currentPosition + direction * moveAmount
    end

    if CONFIG.FaceMob then
        root.CFrame = CFrame.lookAt(newPosition, mobRoot.Position)
    else
        root.CFrame = CFrame.new(newPosition)
    end
end

--//==================================================
--// KILL AURA
--//==================================================
local function getAttackMobs()
    local root = getRoot()
    if not root then
        return {}
    end

    local sorted = getSortedMobsFromPosition(root.Position, CONFIG.AttackRange)
    local mobs = {}

    for i = 1, math.min(CONFIG.MaxMobsPerAttack, #sorted) do
        local mob = sorted[i].Mob

        if isValidMob(mob) then
            mobs[#mobs + 1] = mob
        end
    end

    return mobs
end

local function attackClosestMobs()
    if not CONFIG.Enabled then
        return
    end

    local mobs = getAttackMobs()
    State.LastAttackCount = #mobs

    if #mobs <= 0 then
        return
    end

    local success = pcall(function()
        PlayerAttack:FireServer(mobs)
    end)

    if not success then
        State.Status = "Remote failed. Try raising AttackDelay."
    end
end

--//==================================================
--// GUI
--//==================================================
local function makeGui()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    local old = playerGui:FindFirstChild("SmartMobAuraGui")
    if old then
        old:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "SmartMobAuraGui"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(270, 150)
    frame.Position = UDim2.fromOffset(25, 280)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    frame.BackgroundTransparency = 0.12
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(85, 85, 95)
    stroke.Transparency = 0.25
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -16, 0, 28)
    title.Position = UDim2.fromOffset(8, 6)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "Smart Mob Aura"
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Name = "Status"
    status.Size = UDim2.new(1, -16, 0, 98)
    status.Position = UDim2.fromOffset(8, 36)
    status.BackgroundTransparency = 1
    status.Font = Enum.Font.Gotham
    status.TextSize = 12
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.TextYAlignment = Enum.TextYAlignment.Top
    status.TextColor3 = Color3.fromRGB(210, 210, 215)
    status.Text = "Loading..."
    status.Parent = frame

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(1, -16, 0, 18)
    hint.Position = UDim2.fromOffset(8, 128)
    hint.BackgroundTransparency = 1
    hint.Font = Enum.Font.GothamSemibold
    hint.TextSize = 11
    hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.TextColor3 = Color3.fromRGB(160, 160, 170)
    hint.Text = "N = Toggle | RightControl = Hide GUI"
    hint.Parent = frame

    return gui, status
end

local Gui, StatusLabel = makeGui()

local function updateGui()
    if not StatusLabel then
        return
    end

    local targetName = "None"
    local distance = "N/A"

    if isValidMob(State.CurrentTarget) then
        targetName = State.CurrentTarget.Name
        distance = tostring(math.floor(getDistanceToMob(State.CurrentTarget)))
    end

    StatusLabel.Text =
        "Enabled: " .. tostring(CONFIG.Enabled) ..
        "\nTarget: " .. targetName ..
        "\nDistance: " .. distance ..
        "\nDetected mobs: " .. tostring(State.LastMobCount) ..
        "\nAttacking: " .. tostring(State.LastAttackCount) .. "/" .. tostring(CONFIG.MaxMobsPerAttack) ..
        "\nAttack delay: " .. tostring(CONFIG.AttackDelay) ..
        "\nHeight: " .. tostring(CONFIG.AboveHeight) ..
        "\nMove speed: " .. tostring(CONFIG.MoveSpeed)
end

--//==================================================
--// INPUT
--//==================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == CONFIG.ToggleKey then
        CONFIG.Enabled = not CONFIG.Enabled

        if not CONFIG.Enabled then
            State.CurrentTarget = nil
            restoreCollision()
        end
    end

    if input.KeyCode == CONFIG.GuiToggleKey then
        if Gui then
            Gui.Enabled = not Gui.Enabled
        end
    end
end)

--//==================================================
--// RESPAWN HANDLING
--//==================================================
LocalPlayer.CharacterAdded:Connect(function()
    State.CurrentTarget = nil
    State.DodgeOffset = Vector3.zero
    table.clear(State.OriginalCollision)
end)

--//==================================================
--// MAIN LOOP
--//==================================================
RunService.PreSimulation:Connect(function(dt)
    if CONFIG.Enabled then
        applyNoClip()
        applyAntiSit()
    end

    if not CONFIG.Enabled then
        updateGui()
        return
    end

    if not isPlayerAlive() then
        State.CurrentTarget = nil
        updateGui()
        return
    end

    local root = getRoot()
    if not root then
        State.CurrentTarget = nil
        updateGui()
        return
    end

    local now = tick()

    if now - State.LastTargetRefresh >= CONFIG.TargetRefreshRate then
        State.LastTargetRefresh = now

        pcall(function()
            refreshTarget()
        end)
    end

    if State.CurrentTarget and isValidMob(State.CurrentTarget) then
        pcall(function()
            flyAboveTarget(dt, State.CurrentTarget)
        end)
    end

    if now - State.LastAttack >= CONFIG.AttackDelay then
        State.LastAttack = now

        pcall(function()
            attackClosestMobs()
        end)
    end

    updateGui()
end)
