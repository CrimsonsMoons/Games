--//==================================================
--// FIXED SMART MOB AURA + CFRAME FLY ABOVE + NOCLIP
--//==================================================

--// Settings
local ENABLED = true

local MOVE_SPEED = 165
local ABOVE_HEIGHT = 35
local ARRIVE_DISTANCE = 2

local DODGE_ENABLED = true
local DODGE_RADIUS = 10
local DODGE_SPEED = 3

local ATTACK_DELAY = 0.15
local MAX_MOBS_PER_ATTACK = 5
local ATTACK_RANGE = math.huge -- attacks closest mobs no matter how far

local NOCLIP = true
local ANTI_SIT = true

local TOGGLE_KEY = Enum.KeyCode.N

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folder
local MobsFolder = Workspace:WaitForChild("Mobs", 9e9)

--// State
local CurrentTarget = nil
local LastAttack = 0
local DodgeAngle = 0

--// Player helpers
local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    if not character or not character.Parent then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character.PrimaryPart
end

local function isPlayerAlive()
    local humanoid = getHumanoid()
    return humanoid and humanoid.Health > 0
end

--// Mob helpers
local function getMobRoot(mob)
    if not mob or not mob.Parent then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("RootPart")
        or mob:FindFirstChild("Torso")
        or mob:FindFirstChild("UpperTorso")
        or mob.PrimaryPart
        or mob:FindFirstChildWhichIsA("BasePart")
end

local function getMobHealth(mob)
    if not mob or not mob.Parent then
        return nil
    end

    local humanoid = mob:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        return humanoid.Health
    end

    local attrs = {
        "Health",
        "health",
        "HP",
        "hp",
        "NewHealth",
        "CurrentHealth",
        "currentHealth"
    }

    for _, attr in ipairs(attrs) do
        local value = mob:GetAttribute(attr)
        if typeof(value) == "number" then
            return value
        end
    end

    return nil
end

local function isOwnedByPlayer(mob)
    if not mob or not mob.Parent then
        return true
    end

    local owner =
        mob:GetAttribute("Owner")
        or mob:GetAttribute("owner")
        or mob:GetAttribute("OwnerId")
        or mob:GetAttribute("ownerId")
        or mob:GetAttribute("UserId")
        or mob:GetAttribute("userId")
        or mob:GetAttribute("Summoner")
        or mob:GetAttribute("summoner")

    if owner == nil or owner == "" or owner == 0 then
        return false
    end

    if typeof(owner) == "Instance" then
        if owner:IsA("Player") then
            return true
        end

        if owner:IsA("Model") and Players:GetPlayerFromCharacter(owner) then
            return true
        end
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        local lowerOwner = string.lower(owner)

        for _, player in ipairs(Players:GetPlayers()) do
            if lowerOwner == string.lower(player.Name)
                or lowerOwner == string.lower(player.DisplayName)
                or lowerOwner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    return owner == true
end

local function isDeadByAttribute(mob)
    local deadAttrs = {
        "Dead",
        "dead",
        "Killed",
        "killed",
        "IsDead",
        "isDead"
    }

    for _, attr in ipairs(deadAttrs) do
        if mob:GetAttribute(attr) == true then
            return true
        end
    end

    return false
end

local function isValidMob(mob)
    if not mob or not mob.Parent then
        return false
    end

    if not mob:IsA("Model") then
        return false
    end

    if isOwnedByPlayer(mob) then
        return false
    end

    if isDeadByAttribute(mob) then
        return false
    end

    local health = getMobHealth(mob)
    if typeof(health) == "number" and health <= 0 then
        return false
    end

    if not getMobRoot(mob) then
        return false
    end

    return true
end

--// Smart mob scan
local function getAllValidMobs()
    local root = getRoot()
    if not root then
        return {}
    end

    local found = {}
    local used = {}

    -- GetChildren first, because most games put mobs directly inside workspace.Mobs
    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if isValidMob(mob) and not used[mob] then
            used[mob] = true

            local mobRoot = getMobRoot(mob)
            local distance = (mobRoot.Position - root.Position).Magnitude

            if distance <= ATTACK_RANGE then
                found[#found + 1] = {
                    Mob = mob,
                    Root = mobRoot,
                    Distance = distance,
                    Health = getMobHealth(mob) or math.huge
                }
            end
        end
    end

    -- Backup scan for games where mobs spawn inside folders/models inside workspace.Mobs
    for _, obj in ipairs(MobsFolder:GetDescendants()) do
        if obj:IsA("Model") and isValidMob(obj) and not used[obj] then
            used[obj] = true

            local mobRoot = getMobRoot(obj)
            local distance = (mobRoot.Position - root.Position).Magnitude

            if distance <= ATTACK_RANGE then
                found[#found + 1] = {
                    Mob = obj,
                    Root = mobRoot,
                    Distance = distance,
                    Health = getMobHealth(obj) or math.huge
                }
            end
        end
    end

    table.sort(found, function(a, b)
        if math.abs(a.Distance - b.Distance) <= 4 then
            return a.Health < b.Health
        end

        return a.Distance < b.Distance
    end)

    return found
end

local function getClosestMobs()
    local sorted = getAllValidMobs()
    local mobs = {}

    for i = 1, math.min(MAX_MOBS_PER_ATTACK, #sorted) do
        local mob = sorted[i].Mob

        if isValidMob(mob) then
            mobs[#mobs + 1] = mob
        end
    end

    return mobs, sorted
end

local function getNearestMob()
    local _, sorted = getClosestMobs()

    if sorted[1] and isValidMob(sorted[1].Mob) then
        return sorted[1].Mob
    end

    return nil
end

--// NoClip
local function applyNoClip()
    if not NOCLIP then
        return
    end

    local character = getCharacter()
    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end
end

local function applyAntiSit()
    if not ANTI_SIT then
        return
    end

    local humanoid = getHumanoid()

    if humanoid then
        humanoid.Sit = false
        humanoid.PlatformStand = false
    end
end

--// CFrame fly above mob
local function flyAboveMob(dt, mob)
    if not ENABLED then
        return
    end

    if not isPlayerAlive() or not isValidMob(mob) then
        return
    end

    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return
    end

    DodgeAngle += dt * DODGE_SPEED

    local dodgeOffset = Vector3.zero

    if DODGE_ENABLED then
        dodgeOffset = Vector3.new(
            math.cos(DodgeAngle) * DODGE_RADIUS,
            0,
            math.sin(DodgeAngle) * DODGE_RADIUS
        )
    end

    local targetPosition =
        mobRoot.Position
        + Vector3.new(0, ABOVE_HEIGHT, 0)
        + dodgeOffset

    local currentPosition = root.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local newPosition

    if distance <= ARRIVE_DISTANCE then
        newPosition = targetPosition
    else
        local direction = offset.Unit
        local moveAmount = math.min(MOVE_SPEED * dt, distance)
        newPosition = currentPosition + direction * moveAmount
    end

    root.CFrame = CFrame.lookAt(newPosition, mobRoot.Position)
end

--// Attack
local function attackMobs()
    if not ENABLED then
        return
    end

    local mobs = getClosestMobs()

    if #mobs <= 0 then
        return
    end

    -- Important: this matches your original remote format:
    -- local args = { [1] = {mob1, mob2, mob3} }
    pcall(function()
        PlayerAttack:FireServer(mobs)
    end)
end

--// Input toggle
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        CurrentTarget = nil
        warn("[MobAura] Enabled:", ENABLED)
    end
end)

--// Main movement loop
RunService.PreSimulation:Connect(function(dt)
    if not ENABLED then
        return
    end

    if not isPlayerAlive() then
        CurrentTarget = nil
        return
    end

    applyNoClip()
    applyAntiSit()

    if not isValidMob(CurrentTarget) then
        CurrentTarget = getNearestMob()
    end

    if CurrentTarget and isValidMob(CurrentTarget) then
        flyAboveMob(dt, CurrentTarget)
    end
end)

--// Separate attack loop
task.spawn(function()
    while task.wait(ATTACK_DELAY) do
        if ENABLED then
            attackMobs()
        end
    end
end)
