print("readfile supported:", typeof(readfile) == "function")
print("isfile supported:", typeof(isfile) == "function")
print("isfolder supported:", typeof(isfolder) == "function")
print("listfiles supported:", typeof(listfiles) == "function")

-- Try to find existing autoexec files
if typeof(listfiles) == "function" then
    print("\n=== Checking AutoExec Folders ===")
    
    local folders = {
        "autoexec",
        "AutoExec", 
        "autoexecute",
        "AutoExecute",
        "Delta/AutoExecute",
        "workspace/autoexec"
    }
    
    for _, folder in ipairs(folders) do
        pcall(function()
            if isfolder(folder) then
                print("Found folder:", folder)
                local files = listfiles(folder)
                print("  Files in " .. folder .. ":")
                for _, file in ipairs(files) do
                    print("    -", file)
                end
            end
        end)
    end
end

