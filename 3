--//==================================================
--// SAVE / LOAD SETTINGS
--//==================================================
local function canUseFileSystem()
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(isfile) == "function"
end

local function encodeSettings()
    local data = {
        AutoStartFarm = Config.AutoStartFarm,
        AutoResetBeforeFarm = Config.AutoResetBeforeFarm,

        MoveSpeed = Config.MoveSpeed,
        AboveHeight = Config.AboveHeight,
        DodgeEnabled = Config.DodgeEnabled,
        DodgeRadius = Config.DodgeRadius,
        DodgeSpeed = Config.DodgeSpeed,

        StartMobsPerAttack = Config.StartMobsPerAttack,
        AttackRange = Config.AttackRange,
        AttackDelay = Config.AttackDelay,
        SoloAttackDelay = Config.SoloAttackDelay,

        NoClip = Config.NoClip,
        AntiSit = Config.AntiSit,
        BlacklistPlayerOwned = Config.BlacklistPlayerOwned,
    }

    return game:GetService("HttpService"):JSONEncode(data)
end

local function applyLoadedSettings(data)
    for key, value in pairs(data) do
        if Config[key] ~= nil then
            Config[key] = value
        end
    end

    CurrentMobLimit = Config.StartMobsPerAttack
end

local function saveSettings()
    if not canUseFileSystem() then
        LastStatus = "Save failed: file functions unsupported"
        warn("[SmartAura] Save failed: file functions unsupported")
        return
    end

    local success, err = pcall(function()
        writefile(SETTINGS_FILE, encodeSettings())
    end)

    if success then
        LastStatus = "Settings saved"
        warn("[SmartAura] Settings saved")
    else
        LastStatus = "Save failed"
        warn("[SmartAura] Save failed:", err)
    end
end

local function loadSettings()
    if not canUseFileSystem() then
        LastStatus = "Load skipped: file functions unsupported"
        return
    end

    if not isfile(SETTINGS_FILE) then
        LastStatus = "No saved settings found"
        return
    end

    local success, result = pcall(function()
        local raw = readfile(SETTINGS_FILE)
        return game:GetService("HttpService"):JSONDecode(raw)
    end)

    if success and typeof(result) == "table" then
        applyLoadedSettings(result)
        LastStatus = "Settings loaded"
    else
        LastStatus = "Load failed"
    end
end

