    task.wait(0.25)
    stopIfServerUnsafe()
end)

--//==================================================
--// QUEUE / RE-EXECUTE ON SERVERHOP
--//==================================================
local function getQueueOnTeleport()
    return queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
        or (KRNL_LOADED and queue_on_teleport)
end

local function buildReExecuteLoader()
    return string.format([[
        repeat task.wait() until game:IsLoaded()
        repeat task.wait() until game:GetService("Players").LocalPlayer
        task.wait(0.75)

        local Players = game:GetService("Players")

        if #Players:GetPlayers() > 5 then
            warn("[SmartAura] Re-execute stopped. More than 5 players:", #Players:GetPlayers())
            return
        end

        if isfile and readfile and isfile(%q) then
            loadstring(readfile(%q))()
        else
            warn("[SmartAura] Missing script file:", %q)
        end
    ]], Config.ReExecuteFile, Config.ReExecuteFile, Config.ReExecuteFile)
end

local function queueScriptAfterTeleport()
    if not Config.AutoReExecuteOnTeleport then
        LastStatus = "Auto Re-Execute is OFF"
        return false
    end

    local queue = getQueueOnTeleport()

    if not queue then
        LastStatus = "queue_on_teleport unsupported"
        warn("[SmartAura] queue_on_teleport unsupported")
        return false
    end

    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then
        LastStatus = "Missing file functions"
        warn("[SmartAura] isfile/readfile unsupported")
        return false
    end

    if not isfile(Config.ReExecuteFile) then
        LastStatus = "Missing " .. Config.ReExecuteFile
        warn("[SmartAura] Save full script as:", Config.ReExecuteFile)
        return false
    end

    local loader = buildReExecuteLoader()

    local success, err = pcall(function()
        queue(loader)
    end)

    if success then
        LastStatus = "Queued for serverhop"
        warn("[SmartAura] Queued script for next serverhop")
        return true
    else
        LastStatus = "Queue failed"
        warn("[SmartAura] Queue failed:", err)
        return false
    end
end

local function fireGoAgain()
    if not Config.AutoGoAgain then
        return
    end

    if tick() - LastGoAgainFire < Config.GoAgainCooldown then
        return
    end

    if stopIfServerUnsafe() then
        return
    end

    LastGoAgainFire = tick()

    -- Queue FIRST before serverhop/teleport.
    local queued = queueScriptAfterTeleport()

    task.wait(0.25)

    pcall(function()
        SetExitChoice:FireServer("GoAgain")
    end)

    LastStatus = queued and "GoAgain + re-execute queued" or "GoAgain fired but queue failed"
    warn("[SmartAura] GoAgain fired | queued:", queued)
end

-- Keeps queue ready in case another serverhop happens outside GoAgain.
task.spawn(function()
    while task.wait(5) do
        if Config.AutoReExecuteOnTeleport and isServerSafe() then
            pcall(queueScriptAfterTeleport)
        end
    end
end)

