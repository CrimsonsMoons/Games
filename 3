--//==================================================
--// RESET LOGIC
--//==================================================
local function waitForCharacterRespawn(timeout)
    local start = tick()
    local oldChar = getCharacter()

    repeat
        task.wait(0.1)

        local newChar = getCharacter()
        local hum = getHumanoid()

        if newChar and newChar ~= oldChar and hum and hum.Health > 0 then
            return true
        end
    until tick() - start >= timeout

    return false
end

local function resetCharacterOnce(index, total)
    LastStatus = "Resetting avatar " .. tostring(index) .. "/" .. tostring(total)

    local character = getCharacter()
    local humanoid = getHumanoid()

    if humanoid then
        humanoid.Health = 0
    elseif character then
        character:BreakJoints()
    end

    waitForCharacterRespawn(7)
    task.wait(1.15)
end

local function resetCharacterTimes(amount)
    if ResetRunning then
        return
    end

    if stopIfServerUnsafe() then
        return
    end

    ResetRunning = true
    Config.Enabled = false
    CurrentTarget = nil

    for i = 1, amount do
        if stopIfServerUnsafe() then
            break
        end

        resetCharacterOnce(i, amount)
    end

    ResetRunning = false
    LastStatus = "Reset sequence finished"
end

--//==================================================
--// AUTO RESET WHEN ALONE
--//==================================================
local function isAloneInServer()
    return #Players:GetPlayers() == 1
end

local function resetWhenAlone()
    if not Config.AutoResetWhenAlone then
        return
    end

    if AloneResetRunning then
        return
    end

    if ResetRunning then
        return
    end

    if not isAloneInServer() then
        return
    end

    if tick() - LastAloneReset < Config.AloneResetCooldown then
        return
    end

    if stopIfServerUnsafe() then
        return
    end

    AloneResetRunning = true
    LastAloneReset = tick()

    LastStatus = "Alone server detected. Resetting x9..."

    Config.Enabled = false
    CurrentTarget = nil

    resetCharacterTimes(Config.AloneResetAmount)

    task.wait(0.5)

    startAutoFarm()

    AloneResetRunning = false
    LastStatus = "Alone reset x9 finished"
end

task.spawn(function()
    while task.wait(Config.AloneResetCheckDelay) do
        pcall(resetWhenAlone)
    end
end)

Players.PlayerRemoving:Connect(function()
    task.wait(1)
    pcall(resetWhenAlone)
end)

--//==================================================
--// EXACT CHEST CLAIM BUTTON
--// Path:
--// PlayerGui.ChestOpen.Overlay.ActionButtons.Button
--// Direct fires button events. No mouse position.
--//==================================================
local function getExactClaimButton()
    local chestOpen = PlayerGui:FindFirstChild("ChestOpen")
    if not chestOpen then
        return nil
    end

    local overlay = chestOpen:FindFirstChild("Overlay")
    if not overlay then
        return nil
    end

    local actionButtons = overlay:FindFirstChild("ActionButtons")
    if not actionButtons then
        return nil
    end

    return actionButtons:FindFirstChild("Button")
end

local function isVisibleGuiObject(obj)
    if not obj or not obj:IsA("GuiObject") then
        return false
    end

    if not obj.Visible then
        return false
    end

    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then
        return false
    end

    local current = obj.Parent

    while current and current ~= PlayerGui do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        current = current.Parent
    end

    return true
end

local function isExactClaimButtonReady(button)
    if not button then
        return false
    end

    if not button:IsA("TextButton") and not button:IsA("ImageButton") then
        return false
    end

    if button.Name ~= "Button" then
        return false
    end

    if not button.Active then
        return false
    end

    if not isVisibleGuiObject(button) then
        return false
    end

    return true
end

local function fireButtonSignal(button)
    local fired = false

    if typeof(firesignal) == "function" then
        pcall(function()
            firesignal(button.Activated)
            fired = true
        end)

        pcall(function()
            firesignal(button.MouseButton1Click)
            fired = true
        end)

        pcall(function()
            firesignal(button.MouseButton1Down)
            task.wait(0.03)
            firesignal(button.MouseButton1Up)
            fired = true
        end)
    end

    return fired
end

local function clickExactClaimButton()
    if not Config.AutoClaim then
        return
    end

    if stopIfServerUnsafe() then
        return
    end

    if tick() - LastClaimClick < Config.ClaimClickCooldown then
        return
    end

    local button = getExactClaimButton()

    if not isExactClaimButtonReady(button) then
        return
    end

    LastClaimClick = tick()

    local fired = fireButtonSignal(button)

    if fired then
        LastStatus = "Direct-fired exact chest claim button"
        warn("[AutoClaim] Direct-fired:", button:GetFullName(), "Active:", button.Active)

        task.delay(Config.GoAgainDelay, function()
            fireGoAgain()
        end)
    else
        LastStatus = "firesignal unsupported"
        warn("[AutoClaim] firesignal unsupported")
    end
end

task.spawn(function()
    while task.wait(Config.ClaimScanDelay) do
        pcall(clickExactClaimButton)
    end
end)

PlayerGui.DescendantAdded:Connect(function(obj)
    task.wait(0.1)

    if obj.Name == "Button" then
        pcall(clickExactClaimButton)
    end
end)

