RunService.PreSimulation:Connect(function(dt)
    updateGui()

    if not Config.Enabled then
        return
    end

    if stopIfServerUnsafe() then
        return
    end

    if not isPlayerAlive() then
        CurrentTarget = nil
        return
    end

    applyNoClip()
    applyAntiSit()
    checkStuck(dt)

    local now = tick()

    if now - LastTargetRefresh >= Config.TargetRefreshRate then
        LastTargetRefresh = now
        pcall(refreshTarget)
    end

    if CurrentTarget and isValidMob(CurrentTarget) then
        pcall(function()
            flyAboveMob(dt, CurrentTarget)
        end)
    end

    recoverMobLimit()
end)

--//==================================================
--// ATTACK WORKERS
--//==================================================
local function startAttackWorker(workerName, startDelay)
    task.spawn(function()
        task.wait(startDelay)

        while task.wait(0.05) do
            if Config.Enabled then
                if stopIfServerUnsafe() then
                    task.wait(1)
                    continue
                end

                local mobs = getClosestAttackMobs()

                if #mobs > 0 then
                    attackMobs(workerName)
                    task.wait(getCurrentAttackDelay())
                else
                    LastAttackCount = 0
                    task.wait(0.5)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

startAttackWorker("Loop1", 0)

if Config.OverlapAttackLoops then
    startAttackWorker("Loop2", Config.AttackDelay / 2)
end

