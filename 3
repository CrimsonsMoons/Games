--// SAFETY
--//==================================================
local function applyNoClip()
    if not Config.NoClip then
        return
    end

    local character = getCharacter()

    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end
end

local function applyAntiSit()
    if not Config.AntiSit then
        return
    end

    local humanoid = getHumanoid()

    if humanoid then
        humanoid.Sit = false
        humanoid.PlatformStand = false
    end
end

local function clearVelocity(root)
    if not root then
        return
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

--//==================================================
--// MOVEMENT
--//==================================================
local function flyAboveMob(dt, mob)
    if not Config.Enabled then
        return
    end

    if not isPlayerAlive() or not isValidMob(mob) then
        return
    end

    local root = getRoot()
    local mobRoot = getMobRoot(mob)

    if not root or not mobRoot then
        return
    end

    DodgeAngle += dt * Config.DodgeSpeed

    local dodgeOffset = Vector3.zero

    if Config.DodgeEnabled then
        dodgeOffset = Vector3.new(
            math.cos(DodgeAngle) * Config.DodgeRadius,
            0,
            math.sin(DodgeAngle) * Config.DodgeRadius
        )
    end

    local targetPosition =
        mobRoot.Position
        + Vector3.new(0, Config.AboveHeight, 0)
        + dodgeOffset

    local currentPosition = root.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    LastDistanceToTarget = math.floor(distance)

    clearVelocity(root)

    local newPosition

    if distance <= Config.ArriveDistance then
        newPosition = targetPosition
    else
        local direction = offset.Unit
        local moveAmount = math.min(Config.MoveSpeed * dt, distance)
        newPosition = currentPosition + direction * moveAmount
    end

    root.CFrame = CFrame.lookAt(newPosition, mobRoot.Position)
    LastTargetName = mob.Name
end

local function checkStuck(dt)
    local root = getRoot()

    if not root or not CurrentTarget then
        LastPosition = nil
        StuckTimer = 0
        return
    end

    if not LastPosition then
        LastPosition = root.Position
        StuckTimer = 0
        return
    end

    local moved = (root.Position - LastPosition).Magnitude
    LastPosition = root.Position

    if moved < 0.35 and LastDistanceToTarget > 20 then
        StuckTimer += dt
    else
        StuckTimer = 0
    end

    if StuckTimer >= 1.25 then
        CurrentTarget = nil
        StuckTimer = 0
        LastStatus = "Retargeted: stuck"
    end
end

local function refreshTarget()
    if not Config.Enabled then
        CurrentTarget = nil
        return
    end

    if not isValidMob(CurrentTarget) then
        CurrentTarget = getNearestTweenMob()
        return
    end

    local nearest = getNearestTweenMob()

    if nearest and nearest ~= CurrentTarget then
        local root = getRoot()
        local currentRoot = getMobRoot(CurrentTarget)
        local nearestRoot = getMobRoot(nearest)

        if root and currentRoot and nearestRoot then
            local currentDistance = (currentRoot.Position - root.Position).Magnitude
            local nearestDistance = (nearestRoot.Position - root.Position).Magnitude

            if nearestDistance + 12 < currentDistance then
                CurrentTarget = nearest
                LastStatus = "Switched target"
            end
        end
    end
end

--//==================================================
--// ATTACK
--//==================================================
local function lowerMobLimit()
    if CurrentMobLimit > Config.MinMobsPerAttack then
        CurrentMobLimit -= 1
        LastStatus = "Lowered mob limit to " .. tostring(CurrentMobLimit)
        warn("[SmartAura] " .. LastStatus)
    end
end

local function recoverMobLimit()
    if CurrentMobLimit < Config.StartMobsPerAttack and tick() - LastGoodAttack >= Config.RecoverAfterSeconds then
        CurrentMobLimit += 1
        LastGoodAttack = tick()
        LastStatus = "Recovered mob limit to " .. tostring(CurrentMobLimit)
        warn("[SmartAura] " .. LastStatus)
    end
end

local function attackMobs(workerName)
    if not Config.Enabled then
        return 0
    end

    local mobs = getClosestAttackMobs()

    if #mobs <= 0 then
        LastAttackCount = 0
        return 0
    end

    local clean = {}

    for _, mob in ipairs(mobs) do
        if isValidMob(mob) then
            clean[#clean + 1] = mob
        end
    end

    if #clean <= 0 then
        LastAttackCount = 0
        return 0
    end

    local success = pcall(function()
        PlayerAttack:FireServer(clean)
    end)

    LastAttackCount = #clean

    if success then
        FailCount = 0
        LastGoodAttack = tick()
        LastStatus = workerName .. " fired " .. tostring(#clean)
    else
        FailCount += 1
        LastStatus = workerName .. " failed"

        if FailCount >= Config.FailsBeforeLowering then
            FailCount = 0
            lowerMobLimit()
        end
    end

    return #clean
end

local function getCurrentAttackDelay()
    local mobs = getClosestAttackMobs()

    if #mobs == 1 then
        return Config.SoloAttackDelay
    end

    return Config.AttackDelay
end

