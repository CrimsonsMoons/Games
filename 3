--// Settings
local RANGE = 100 -- only mobs within 100 studs
local ATTACK_DELAY = 0.12
local MAX_MOBS_PER_ATTACK = 3 -- closest 3 mobs only

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local PlayerAttack = ReplicatedStorage
    :WaitForChild("Systems", 9e9)
    :WaitForChild("Combat", 9e9)
    :WaitForChild("PlayerAttack", 9e9)

--// Folder
local MobsFolder = workspace:WaitForChild("Mobs", 9e9)

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getMyRoot()
    local character = getCharacter()

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character.PrimaryPart
end

local function getRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function isOwnedByPlayer(mob)
    local owner = mob:GetAttribute("Owner") or mob:GetAttribute("owner")

    if owner == nil then
        return false
    end

    if typeof(owner) == "Instance" and owner:IsA("Player") then
        return true
    end

    if typeof(owner) == "number" then
        return Players:GetPlayerByUserId(owner) ~= nil
    end

    if typeof(owner) == "string" then
        for _, player in ipairs(Players:GetPlayers()) do
            if owner == player.Name
                or owner == player.DisplayName
                or owner == tostring(player.UserId)
            then
                return true
            end
        end
    end

    if owner == true then
        return true
    end

    return false
end

local function isMobAlive(mob)
    if not mob or not mob.Parent then
        return false
    end

    local humanoid = mob:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return false
    end

    local health = mob:GetAttribute("Health")
        or mob:GetAttribute("NewHealth")
        or mob:GetAttribute("HP")

    if typeof(health) == "number" and health <= 0 then
        return false
    end

    return true
end

local function getClosestMobs()
    local myRoot = getMyRoot()
    if not myRoot then return {} end

    local mobs = {}

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        if mob:IsA("Model")
            and isMobAlive(mob)
            and not isOwnedByPlayer(mob)
        then
            local mobRoot = getRoot(mob)

            if mobRoot then
                local distance = (mobRoot.Position - myRoot.Position).Magnitude

                if distance <= RANGE then
                    mobs[#mobs + 1] = {
                        Model = mob,
                        Distance = distance
                    }
                end
            end
        end
    end

    -- Closest mobs first
    table.sort(mobs, function(a, b)
        return a.Distance < b.Distance
    end)

    local closestMobs = {}

    for i = 1, math.min(MAX_MOBS_PER_ATTACK, #mobs) do
        closestMobs[#closestMobs + 1] = mobs[i].Model
    end

    return closestMobs
end

while task.wait(ATTACK_DELAY) do
    local mobs = getClosestMobs()

    if #mobs > 0 then
        PlayerAttack:FireServer(mobs)
    end
end
