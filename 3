--//==================================================
--// SAVE / LOAD SETTINGS
--//==================================================
local function canSaveSettings()
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(isfile) == "function"
end

local function saveSettings()
    if not canSaveSettings() then
        LastStatus = "Save unsupported"
        warn("[SmartAura] Save unsupported")
        return
    end

    local data = {
        AutoResetOnExecution = Config.AutoResetOnExecution,
        AutoClaim = Config.AutoClaim,
        AutoGoAgain = Config.AutoGoAgain,
        AutoReExecuteOnTeleport = Config.AutoReExecuteOnTeleport
    }

    local success, err = pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
    end)

    if success then
        LastStatus = "Settings saved"
        warn("[SmartAura] Settings saved")
    else
        LastStatus = "Save failed: " .. tostring(err)
        warn("[SmartAura] Save failed:", err)
    end
end

local function loadSettings()
    if not canSaveSettings() then
        LastStatus = "Save unsupported. Defaults used."
        return
    end

    if not isfile(SETTINGS_FILE) then
        LastStatus = "No saved settings. Defaults used."
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(SETTINGS_FILE))
    end)

    if success and typeof(data) == "table" then
        if typeof(data.AutoResetOnExecution) == "boolean" then
            Config.AutoResetOnExecution = data.AutoResetOnExecution
        end

        if typeof(data.AutoClaim) == "boolean" then
            Config.AutoClaim = data.AutoClaim
        end

        if typeof(data.AutoGoAgain) == "boolean" then
            Config.AutoGoAgain = data.AutoGoAgain
        end

        if typeof(data.AutoReExecuteOnTeleport) == "boolean" then
            Config.AutoReExecuteOnTeleport = data.AutoReExecuteOnTeleport
        end

        LastStatus = "Settings loaded"
    else
        LastStatus = "Settings load failed"
    end
end

loadSettings()

--//==================================================
--// SERVER SAFETY
--//==================================================
local function isServerSafe()
    return #Players:GetPlayers() <= Config.MaxServerPlayers
end

local function stopIfServerUnsafe()
    if isServerSafe() then
        return false
    end

    Config.Enabled = false
    LastStatus = "Stopped: server has " .. tostring(#Players:GetPlayers()) .. " players"
    warn("[SmartAura] Stopped because server has more than 5 players:", #Players:GetPlayers())
    return true
end

